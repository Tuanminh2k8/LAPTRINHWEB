@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Source.Helpers
@using Source.Models
@{
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? HttpContextAccessor.HttpContext?.User.FindFirst("FullName")?.Value ?? "Người bán";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var pageTitle = (ViewData["Title"]?.ToString() ?? "Kênh Người Bán") + " - PolyFood Store";
    var siteDescription = "PolyFood Seller Centre - Hệ thống quản lý bán hàng chuyên nghiệp.";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@siteDescription" />
    <meta name="keywords" content="fast food, quản lý bán hàng, shopee seller, kênh người bán, polyfood" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@pageTitle</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" onload="this.media='all'" />
    <noscript>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    </noscript>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sales-variant-manager.css" asp-append-version="true" />
    @Html.AntiForgeryToken()
    <style>
        :root {
            --seller-primary: #ee4d2d; /* Màu cam shopee */
            --seller-primary-hover: #d73c1d;
            --seller-bg: #f5f5f5;
            --seller-sidebar-width: 240px;
        }
        body {
            background-color: var(--seller-bg);
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .seller-sidebar-bg {
            background: #ffffff;
            box-shadow: 2px 0 10px rgba(0,0,0,0.05);
            border-right: 1px solid #e0e0e0;
        }
        .seller-nav-link {
            display: flex;
            align-items: center;
            padding: 12px 20px;
            color: #333333;
            font-weight: 500;
            text-decoration: none;
            border-radius: 8px;
            margin: 4px 12px;
            transition: all 0.2s ease;
        }
        .seller-nav-link:hover {
            background-color: #fafafa;
            color: var(--seller-primary);
        }
        .seller-nav-link.active {
            background-color: #feeed5;
            color: var(--seller-primary);
            font-weight: 600;
        }
        .seller-nav-link i {
            font-size: 1.1rem;
            width: 24px;
        }
        .seller-content-area {
            margin-left: var(--seller-sidebar-width);
            transition: all 0.3s ease;
        }
        @@media (max-width: 991.98px) {
            .seller-content-area {
                margin-left: 0;
                padding-top: 56px;
            }
        }
        .btn-seller-primary {
            background-color: var(--seller-primary);
            color: #fff;
            border: none;
            transition: all 0.2s ease;
        }
        .btn-seller-primary:hover {
            background-color: var(--seller-primary-hover);
            color: #fff;
        }
        .seller-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            background: #fff;
        }
        .seller-card-header {
            background: #fff;
            border-bottom: 1px solid #f0f0f0;
            padding: 20px;
            border-top-left-radius: 12px !important;
            border-top-right-radius: 12px !important;
        }
        .seller-badge {
            background-color: var(--seller-primary);
            color: white;
            font-size: 0.7rem;
            padding: 3px 8px;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <!-- Mobile Sidebar offcanvas -->
    <div class="offcanvas offcanvas-start d-lg-none seller-sidebar-bg" tabindex="-1" id="sellerSidebar" aria-label="Menu người bán">
        <div class="offcanvas-header border-bottom">
            <h6 class="fw-bold mb-0 d-flex align-items-center gap-2 text-danger">
                <span class="brand-icon bg-danger text-white rounded-circle d-flex align-items-center justify-content-center" style="width:32px;height:32px;"><i class="fa-solid fa-store"></i></span>
                Seller Centre
            </h6>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-2">
            <nav class="nav flex-column gap-1">
                <a class="seller-nav-link @(currentController == "Seller" && currentAction == "Index" ? "active" : "")" asp-controller="Seller" asp-action="Index">
                    <i class="fa-solid fa-chart-pie me-2"></i> Dashboard
                </a>
                <a class="seller-nav-link @(currentController == "Seller" && currentAction == "Foods" ? "active" : "")" asp-controller="Seller" asp-action="Foods">
                    <i class="fa-solid fa-burger me-2"></i> Sản Phẩm
                </a>
                <a class="seller-nav-link @(currentController == "Seller" && currentAction == "Modifiers" ? "active" : "")" asp-controller="Seller" asp-action="Modifiers">
                    <i class="fa-solid fa-sliders me-2"></i> Tùy Chọn Món
                </a>
                <a class="seller-nav-link @(currentController == "Seller" && currentAction == "Orders" ? "active" : "")" asp-controller="Seller" asp-action="Orders">
                    <i class="fa-solid fa-receipt me-2"></i> Đơn Hàng
                </a>
                <hr class="my-2 mx-3">
                <a class="seller-nav-link" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-arrow-left-long me-2"></i> Xem Trang Chủ
                </a>
            </nav>
        </div>
    </div>

    <!-- Desktop Sidebar -->
    <aside class="d-none d-lg-flex position-fixed top-0 start-0 bottom-0 flex-column seller-sidebar-bg" style="width: var(--seller-sidebar-width); z-index: 1030;">
        <div class="p-3 border-bottom text-center">
            <a asp-controller="Seller" asp-action="Index" class="text-decoration-none">
                <div class="mx-auto mb-2 bg-danger text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-store fs-5"></i>
                </div>
                <h6 class="fw-bold text-dark mb-0">Seller Centre</h6>
                <span class="seller-badge mt-1 d-inline-block">Người Bán Hàng</span>
            </a>
        </div>
        <nav class="nav flex-column gap-1 py-3 flex-grow-1">
            <a class="seller-nav-link @(currentController == "Seller" && currentAction == "Index" ? "active" : "")" asp-controller="Seller" asp-action="Index">
                <i class="fa-solid fa-chart-pie me-2"></i> Dashboard
            </a>
            <a class="seller-nav-link @(currentController == "Seller" && (currentAction == "Foods" || currentAction == "FoodCreate" || currentAction == "FoodEdit") ? "active" : "")" asp-controller="Seller" asp-action="Foods">
                <i class="fa-solid fa-burger me-2"></i> Sản Phẩm
            </a>
            <a class="seller-nav-link @(currentController == "Seller" && currentAction == "Modifiers" ? "active" : "")" asp-controller="Seller" asp-action="Modifiers">
                <i class="fa-solid fa-sliders me-2"></i> Tùy Chọn Món
            </a>
            <a class="seller-nav-link @(currentController == "Seller" && (currentAction == "Orders" || currentAction == "OrderDetail") ? "active" : "")" asp-controller="Seller" asp-action="Orders">
                <i class="fa-solid fa-receipt me-2"></i> Đơn Hàng
            </a>
            <hr class="border-white border-opacity-10 my-2">
            <a class="seller-nav-link" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-arrow-left-long me-2"></i> Xem Trang Chủ
            </a>
        </nav>
        <div class="p-3 border-top">
            <div class="d-flex align-items-center gap-2 text-muted small">
                <i class="fa-solid fa-circle-user text-danger fs-5"></i>
                <span class="text-truncate fw-semibold">@fullName</span>
            </div>
        </div>
    </aside>

    <!-- Mobile Top Header Bar -->
    <nav class="navbar navbar-dark bg-dark fixed-top shadow-sm d-flex d-lg-none" style="z-index: 1041; height: 56px;">
        <div class="container-fluid px-3">
            <button class="btn btn-outline-light border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#sellerSidebar" aria-label="Mở menu">
                <i class="fa-solid fa-bars fs-5"></i>
            </button>
            <a class="navbar-brand fw-bold text-danger mb-0 small" asp-controller="Seller" asp-action="Index">
                <i class="fa-solid fa-store me-1"></i> Seller Centre
            </a>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-pill px-2 py-1">
                <i class="fa-solid fa-right-from-bracket"></i>
            </a>
        </div>
    </nav>

    <!-- Main Content Area -->
    <div class="seller-content-area">
        <div class="p-4" style="min-height: 100vh;">
            <!-- Desktop Topbar -->
            <div class="d-none d-lg-flex justify-content-between align-items-center mb-4 p-3 bg-white rounded-3 shadow-sm border">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-store text-danger fs-4"></i>
                    <div>
                        <small class="text-muted d-block" style="font-size: .75rem;">Kênh bán hàng của bạn,</small>
                        <strong class="text-dark">@fullName</strong>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                        <i class="fa-solid fa-globe me-1"></i> Xem trang khách
                    </a>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-danger btn-sm rounded-pill px-3">
                        <i class="fa-solid fa-right-from-bracket me-1"></i> Đăng xuất
                    </a>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center py-3 px-4" role="alert">
                    <i class="fa-solid fa-circle-check fs-5 me-2 text-success"></i>
                    <div class="fw-600 small">@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center py-3 px-4" role="alert">
                    <i class="fa-solid fa-circle-exclamation fs-5 me-2 text-danger"></i>
                    <div class="fw-600 small">@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <!-- Toast + Scroll top -->
    <div id="toastContainer" class="position-fixed bottom-0 end-0 p-3" style="z-index:1090"></div>
    <button id="btnScrollTop" class="btn-scroll-top" aria-label="Cuộn lên đầu trang">
        <i class="fa-solid fa-chevron-up"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sales-variant-manager.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
