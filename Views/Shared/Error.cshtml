@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center py-5">
            <div class="mb-4">
                <i class="fa-solid fa-triangle-exclamation text-warning" style="font-size: 5rem;"></i>
            </div>
            <h1 class="fw-bold text-dark mb-3">Đã xảy ra lỗi</h1>
            <p class="text-muted fs-5 mb-4">
                Xin lỗi, có lỗi xảy ra trong quá trình xử lý yêu cầu của bạn.
                Vui lòng thử lại hoặc quay về trang chủ.
            </p>
            
            @if (Model.ShowRequestId)
            {
                <div class="glass-panel p-3 mb-4 text-start">
                    <small class="text-muted">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        <strong>Mã lỗi:</strong> <code>@Model.RequestId</code>
                    </small>
                </div>
            }
            
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom btn-custom px-4">
                    <i class="fa-solid fa-house me-2"></i>Về trang chủ
                </a>
                <button onclick="history.back()" class="btn btn-secondary-custom btn-custom px-4">
                    <i class="fa-solid fa-arrow-left me-2"></i>Quay lại
                </button>
            </div>
        </div>
    </div>
</div>
