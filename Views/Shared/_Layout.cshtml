@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Source.Helpers
@using Source.Models
@{
    var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId");
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? HttpContextAccessor.HttpContext?.User.FindFirst("FullName")?.Value;
    var role = HttpContextAccessor.HttpContext?.Session.GetString("Role") ?? HttpContextAccessor.HttpContext?.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    
    var cart = HttpContextAccessor.HttpContext?.Session.GetObjectFromJson<List<CartItem>>("FastFoodCart") ?? new List<CartItem>();
    var cartCount = cart.Sum(i => i.Quantity);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PolyFood Store</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap and Font Awesome -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-custom fixed-top shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon"><i class="fa-solid fa-burger"></i></div>
                    <span class="brand-text">Poly<span class="text-danger">Food</span></span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse justify-content-between" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-house me-1"></i> Trang chủ
                            </a>
                        </li>
                        @if (role == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom text-danger fw-bold" asp-controller="Admin" asp-action="Index">
                                    <i class="fa-solid fa-gauge-high me-1"></i> Quản trị System
                                </a>
                            </li>
                        }
                    </ul>
                    
                    <div class="d-flex align-items-center gap-3">
                        <!-- Shopping Cart Button -->
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-cart-icon position-relative text-dark">
                            <i class="fa-solid fa-cart-shopping fs-5"></i>
                            <span id="cart-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light @(cartCount > 0 ? "" : "d-none")">
                                @cartCount
                            </span>
                        </a>

                        @if (userId.HasValue || HttpContextAccessor.HttpContext?.User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <button class="btn btn-user-menu dropdown-toggle d-flex align-items-center gap-2" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-circle-user fs-5 text-danger"></i>
                                    <span class="fw-600 text-dark">@fullName</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg mt-2 rounded-3" aria-labelledby="userMenu">
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile"><i class="fa-solid fa-id-card me-2 text-muted"></i> Hồ sơ cá nhân</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Cart" asp-action="OrderHistory"><i class="fa-solid fa-receipt me-2 text-muted"></i> Lịch sử đơn hàng</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2 text-danger fw-600" asp-controller="Account" asp-action="Logout"><i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2 fw-600">
                                <i class="fa-solid fa-right-to-bracket me-1"></i> Đăng nhập
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-danger btn-sm rounded-pill px-3 py-2 fw-600 shadow-sm">
                                Đăng ký
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-wrapper" style="margin-top: 78px;">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center" role="alert">
                    <i class="fa-solid fa-circle-check fs-5 me-2 text-success"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center" role="alert">
                    <i class="fa-solid fa-circle-exclamation fs-5 me-2 text-danger"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto py-4 bg-dark text-light">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-5">
                    <h5 class="fw-bold text-white mb-3"><i class="fa-solid fa-burger text-danger me-2"></i>PolyFood FastFood</h5>
                    <p class="text-white-50 small pe-lg-4">Hệ thống phân phối và đặt hàng thức ăn nhanh hiện đại. Cam kết giao hàng nóng hổi, vệ sinh an toàn thực phẩm 100%.</p>
                </div>
                <div class="col-md-3">
                    <h6 class="fw-bold text-white mb-3">Liên kết nhanh</h6>
                    <ul class="list-unstyled text-white-50 small">
                        <li><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none hover-white">Trang chủ Menu</a></li>
                        <li><a asp-controller="Cart" asp-action="Index" class="text-white-50 text-decoration-none hover-white">Giỏ hàng của bạn</a></li>
                        <li><a asp-controller="Account" asp-action="Login" class="text-white-50 text-decoration-none hover-white">Đăng nhập / Đăng ký</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold text-white mb-3">Thông tin liên hệ</h6>
                    <p class="text-white-50 small mb-1"><i class="fa-solid fa-location-dot me-2 text-danger"></i>123 Tô Ký, Q.12, TP. Hồ Chí Minh</p>
                    <p class="text-white-50 small mb-1"><i class="fa-solid fa-phone me-2 text-danger"></i>Hotline: 1900 6789</p>
                    <p class="text-white-50 small"><i class="fa-solid fa-envelope me-2 text-danger"></i>Support: cskh@polyfood.com</p>
                </div>
            </div>
            <hr class="my-4 border-secondary">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center text-white-50 small">
                <div>&copy; 2026 <strong>PolyFood</strong>. Production standard ASP.NET Core MVC.</div>
                <div class="mt-2 mt-md-0">Môn học: SOF2041 / Lập trình Web cơ bản</div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
