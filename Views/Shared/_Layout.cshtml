@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Source.Helpers
@using Source.Models
@{
    var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId");
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName");
    var role = HttpContextAccessor.HttpContext?.Session.GetString("Role");
    
    var cart = HttpContextAccessor.HttpContext?.Session.GetObjectFromJson<List<CartItem>>("FastFoodCart") ?? new List<CartItem>();
    var cartCount = cart.Sum(i => i.Quantity);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PolyFood Cửa Hàng Thức Ăn Nhanh</title>
    
    <!-- Bootstrap and Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Source.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom fixed-top">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid stroke-orange-500 fa-hamburger"></i> Poly<span>Food</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse id="navbarContent" class="justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-house me-1"></i> Trang chủ
                            </a>
                        </li>
                        @if (role == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-bold" asp-controller="Admin" asp-action="Index">
                                    <i class="fa-solid fa-gauge-high me-1"></i> Quản trị
                                </a>
                            </li>
                        }
                    </ul>
                    
                    <div class="d-flex align-items-center gap-3">
                        <!-- Shopping Cart -->
                        <a asp-controller="Cart" asp-action="Index" class="position-relative p-2 text-dark text-decoration-none nav-link">
                            <i class="fa-solid fa-cart-shopping fa-lg"></i>
                            <span id="cart-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger @(cartCount > 0 ? "" : "d-none")">
                                @cartCount
                            </span>
                        </a>

                        @if (userId.HasValue)
                        {
                            <div class="dropdown">
                                <button class="btn btn-link text-dark text-decoration-none dropdown-toggle nav-link border-0" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-user-circle fa-lg me-1"></i> Chào, @fullName
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm" aria-labelledby="userMenu">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="fa-solid fa-user-pen me-2"></i> Hồ sơ cá nhân</a></li>
                                    <li><a class="dropdown-item" asp-controller="Cart" asp-action="OrderHistory"><i class="fa-solid fa-clock-rotate-left me-2"></i> Lịch sử đặt hàng</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                <i class="fa-solid fa-right-to-bracket me-1"></i> Đăng nhập
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-danger btn-sm rounded-pill px-3">
                                Đăng ký
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid p-0" style="margin-top: 76px;">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer py-4 bg-white text-muted mt-auto">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    &copy; 2026 - <strong>PolyFood FastFood Store</strong>. Thiết kế cho môn học Lập trình Web cơ bản.
                </div>
                <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                    <span class="badge bg-light text-dark border p-2">Môn học: SOF2041 / Lập trình Web cơ bản</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
