@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Source.Helpers
@using Source.Models
@{
    var isAuthenticated = HttpContextAccessor.HttpContext?.User.Identity?.IsAuthenticated == true;
    var fullName = HttpContextAccessor.HttpContext?.User.FindFirst("FullName")?.Value ?? HttpContextAccessor.HttpContext?.User.Identity?.Name;
    var role = HttpContextAccessor.HttpContext?.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    
    var cart = HttpContextAccessor.HttpContext?.Session.GetObjectFromJson<List<CartItem>>("FastFoodCart") ?? new List<CartItem>();
    var cartCount = cart.Sum(i => i.Quantity);
    
    var pageTitle = (ViewData["Title"]?.ToString() ?? "Trang chủ") + " - PolyFood Store";
    var siteDescription = "PolyFood - Hệ thống đặt thức ăn nhanh hàng đầu. Giao hàng siêu tốc trong 30 phút.";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@siteDescription" />
    <meta name="keywords" content="fast food, đồ ăn nhanh, pizza, burger, gà rán, đặt đồ ăn online" />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@siteDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/default_food.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@siteDescription" />
    <link rel="canonical" href="https://polyfood.example.com" />
    <title>@pageTitle</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @Html.AntiForgeryToken()
</head>
<body>
    <div class="preloader" id="preloader">
        <div class="preloader-spinner"></div>
    </div>

    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-polyfood fixed-top">
            <div class="container px-4">
                <a class="navbar-brand d-flex align-items-center gap-3" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon">
                        <i class="fa-solid fa-burger fa-xl text-primary"></i>
                    </div>
                    <div>
                        <h1 class="brand-text m-0">Poly<span class="text-danger">Food</span></h1>
                        <p class="m-0 text-muted small">Đồng Nai, Việt Nam</p>
                    </div>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-center" id="navbarContent">
                    <ul class="navbar-nav mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link nav-link-polyfood @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-house me-2"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-polyfood @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Menu" ? "active" : "")" asp-controller="Home" asp-action="Menu">
                                <i class="fa-solid fa-utensils me-2"></i> Thực đơn
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-polyfood @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Combos" ? "active" : "")" asp-controller="Home" asp-action="Combos">
                                <i class="fa-solid fa-box me-2"></i> Combo
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-polyfood @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Promotions" ? "active" : "")" asp-controller="Home" asp-action="Promotions">
                                <i class="fa-solid fa-tags me-2"></i> Khuyến mãi
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-polyfood @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" asp-controller="Home" asp-action="About">
                                <i class="fa-solid fa-info-circle me-2"></i> Về chúng tôi
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3 ms-lg-4">
                        <button class="btn-location d-none d-lg-flex" onclick="window.location='https://maps.google.com/?q=Ha+Noi'">
                            <i class="fa-solid fa-location-dot text-danger"></i>
                            <span>Đồng Nai</span>
                        </button>

                        <a asp-controller="Cart" asp-action="Index" class="btn btn-cart-polyfood position-relative" aria-label="Giỏ hàng">
                            <i class="fa-solid fa-cart-shopping fa-lg"></i>
                            <span id="cart-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light @(cartCount > 0 ? "" : "d-none")">
                                @cartCount
                            </span>
                        </a>

                        @if (isAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn btn-user-nav dropdown-toggle d-flex align-items-center gap-2" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-circle-user fa-lg text-danger"></i>
                                    <span class="fw-semibold d-none d-md-inline">@fullName</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg mt-2" aria-labelledby="userMenu">
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile"><i class="fa-solid fa-id-card me-2 text-muted"></i> Hồ sơ cá nhân</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Cart" asp-action="OrderHistory"><i class="fa-solid fa-receipt me-2 text-muted"></i> Lịch sử đơn hàng</a></li>
                                    @if (role == "Admin")
                                    {
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li><a class="dropdown-item py-2 fw-bold text-danger" asp-controller="Admin" asp-action="Index"><i class="fa-solid fa-shield-hooded me-2"></i> Trang quản trị</a></li>
                                    }
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li><a class="dropdown-item py-2 text-danger fw-bold" asp-controller="Account" asp-action="Logout"><i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-login-nav">
                                <i class="fa-solid fa-right-to-bracket me-2"></i> Đăng nhập
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @if (isAuthenticated && role == "Admin")
    {
    <div class="admin-return-bar" id="adminReturnBar">
        <a asp-controller="Admin" asp-action="Index" class="admin-return-btn">
            <i class="fa-solid fa-shield-hooded"></i> Quay lại Quản trị
        </a>
    </div>
    }

    <div class="main-wrapper animate-fadeIn @(isAuthenticated && role == "Admin" ? "has-admin-bar" : "")" style="margin-top: var(--nav-height);">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 d-flex align-items-center py-3 px-4" role="alert">
                    <i class="fa-solid fa-circle-check fs-5 me-2 text-success"></i>
                    <div class="fw-600 small">@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 d-flex align-items-center py-3 px-4" role="alert">
                    <i class="fa-solid fa-circle-exclamation fs-5 me-2 text-danger"></i>
                    <div class="fw-600 small">@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <div id="toastContainer" class="position-fixed bottom-0 end-0 p-3" style="z-index:1090"></div>

    <button id="btnScrollTop" class="btn-scroll-top" aria-label="Cuộn lên đầu trang">
        <i class="fa-solid fa-chevron-up"></i>
    </button>

    <footer class="footer mt-auto py-5">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
                        <span class="footer-brand-icon"><i class="fa-solid fa-burger"></i></span>
                        PolyFood
                    </h5>
                    <p class="text-white-50 small pe-lg-4 lh-lg">Hệ thống phân phối và đặt hàng thức ăn nhanh hiện đại. Cam kết giao hàng nóng hổi, vệ sinh an toàn thực phẩm 100%.</p>
                    <div class="d-flex gap-3 mt-3">
                        <a href="#" class="social-link" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#" class="social-link" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="social-link" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a>
                        <a href="#" class="social-link" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold text-white mb-3">Liên kết nhanh</h6>
                    <ul class="list-unstyled text-white-50 small lh-lg">
                        <li><a asp-controller="Home" asp-action="Index" class="text-decoration-none"><i class="fa-solid fa-angle-right me-1"></i> Trang chủ</a></li>
                        <li><a asp-controller="Home" asp-action="Menu" class="text-decoration-none"><i class="fa-solid fa-angle-right me-1"></i> Thực đơn</a></li>
                        <li><a asp-controller="Home" asp-action="Combos" class="text-decoration-none"><i class="fa-solid fa-angle-right me-1"></i> Combo</a></li>
                        <li><a asp-controller="Home" asp-action="Promotions" class="text-decoration-none"><i class="fa-solid fa-angle-right me-1"></i> Khuyến mãi</a></li>
                        <li><a asp-controller="Home" asp-action="About" class="text-decoration-none"><i class="fa-solid fa-angle-right me-1"></i> Về chúng tôi</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-white mb-3">Liên hệ</h6>
                    <ul class="list-unstyled text-white-50 small lh-lg">
                        <li class="d-flex align-items-start gap-2 mb-2">
                            <i class="fa-solid fa-location-dot mt-1 flex-shrink-0"></i>
                            <span>Trụ sở: Tòa nhà Poly, Khu Công Nghệ Cao, Biên Hòa, Đồng Nai</span>
                        </li>
                        <li class="d-flex align-items-center gap-2 mb-2">
                            <i class="fa-solid fa-phone flex-shrink-0"></i>
                            <a href="tel:0338301054" class="text-decoration-none">0338 301 054</a>
                        </li>
                        <li class="d-flex align-items-center gap-2 mb-2">
                            <i class="fa-solid fa-envelope flex-shrink-0"></i>
                            <a href="mailto:info@polyfood.vn" class="text-decoration-none">info@polyfood.vn</a>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-clock flex-shrink-0"></i>
                            <span>7:00 - 22:00 (T2 - CN)</span>
                        </li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-white mb-3">Chính sách</h6>
                    <ul class="list-unstyled text-white-50 small lh-lg">
                        <li><a href="#" class="text-decoration-none"><i class="fa-solid fa-angle-right me-1"></i> Chính sách đặt hàng</a></li>
                        <li><a href="#" class="text-decoration-none"><i class="fa-solid fa-angle-right me-1"></i> Chính sách giao hàng</a></li>
                        <li><a href="#" class="text-decoration-none"><i class="fa-solid fa-angle-right me-1"></i> Chính sách đổi trả</a></li>
                        <li><a href="#" class="text-decoration-none"><i class="fa-solid fa-angle-right me-1"></i> Chính sách bảo mật</a></li>
                        <li><a href="#" class="text-decoration-none"><i class="fa-solid fa-angle-right me-1"></i> Điều khoản sử dụng</a></li>
                    </ul>
                </div>
            </div>
            <div class="copyright">
                &copy; @DateTime.Now.Year PolyFood Store. Tất cả quyền được bảo lưu.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
