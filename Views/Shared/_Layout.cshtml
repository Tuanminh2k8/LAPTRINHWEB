@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Source.Helpers
@using Source.Models
@{
    var isAuthenticated = HttpContextAccessor.HttpContext?.User.Identity?.IsAuthenticated == true;
    var fullName = HttpContextAccessor.HttpContext?.User.FindFirst("FullName")?.Value ?? HttpContextAccessor.HttpContext?.User.Identity?.Name;
    var role = HttpContextAccessor.HttpContext?.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    
    var cart = HttpContextAccessor.HttpContext?.Session.GetObjectFromJson<List<CartItem>>("FastFoodCart") ?? new List<CartItem>();
    var cartCount = cart.Sum(i => i.Quantity);

    var pageTitle = (ViewData["Title"]?.ToString() ?? "Trang chủ") + " - PolyFood Store";
    var siteDescription = "PolyFood - Hệ thống đặt thức ăn nhanh hàng đầu. Giao hàng siêu tốc trong 30 phút.";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@siteDescription" />
    <meta name="keywords" content="fast food, đồ ăn nhanh, pizza, burger, gà rán, đặt đồ ăn online" />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@siteDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/default_food.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@siteDescription" />
    <link rel="canonical" href="https://polyfood.example.com" />
    <title>@pageTitle</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="preloader" id="preloader">
        <div class="preloader-spinner"></div>
    </div>

    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-custom fixed-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon"><i class="fa-solid fa-burger"></i></div>
                    <span class="brand-text">Poly<span class="text-danger">Food</span></span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse justify-content-between" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-house me-1"></i> Trang chủ
                            </a>
                        </li>
                        @if (role == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom text-danger fw-bold" asp-controller="Admin" asp-action="Index">
                                    <i class="fa-solid fa-gauge-high me-1"></i> Quản trị
                                </a>
                            </li>
                        }
                    </ul>
                    
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-cart-icon position-relative text-dark" aria-label="Giỏ hàng">
                            <i class="fa-solid fa-cart-shopping fs-5"></i>
                            <span id="cart-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light @(cartCount > 0 ? "" : "d-none")">
                                @cartCount
                            </span>
                        </a>

                        @if (isAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn btn-user-menu dropdown-toggle d-flex align-items-center gap-2" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-circle-user fs-5 text-danger"></i>
                                    <span class="fw-semibold d-none d-md-inline">@fullName</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg mt-2" aria-labelledby="userMenu">
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile"><i class="fa-solid fa-id-card me-2 text-muted"></i> Hồ sơ cá nhân</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Cart" asp-action="OrderHistory"><i class="fa-solid fa-receipt me-2 text-muted"></i> Lịch sử đơn hàng</a></li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li><a class="dropdown-item py-2 text-danger fw-bold" asp-controller="Account" asp-action="Logout"><i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-auth btn-auth-outline">
                                <i class="fa-solid fa-right-to-bracket me-1"></i> Đăng nhập
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-auth btn-auth-solid">
                                Đăng ký
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-wrapper animate-fadeIn" style="margin-top: var(--nav-height);">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 d-flex align-items-center py-3 px-4" role="alert">
                    <i class="fa-solid fa-circle-check fs-5 me-2 text-success"></i>
                    <div class="fw-600 small">@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 d-flex align-items-center py-3 px-4" role="alert">
                    <i class="fa-solid fa-circle-exclamation fs-5 me-2 text-danger"></i>
                    <div class="fw-600 small">@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <div id="toastContainer" class="position-fixed bottom-0 end-0 p-3" style="z-index:1090"></div>

    <button id="btnScrollTop" class="btn-scroll-top" aria-label="Cuộn lên đầu trang">
        <i class="fa-solid fa-chevron-up"></i>
    </button>

    <footer class="footer mt-auto py-5 bg-dark text-light">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-5">
                    <h5 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
                        <span class="footer-brand-icon"><i class="fa-solid fa-burger"></i></span>
                        PolyFood
                    </h5>
                    <p class="text-white-50 small pe-lg-4 lh-lg">Hệ thống phân phối và đặt hàng thức ăn nhanh hiện đại. Cam kết giao hàng nóng hổi, vệ sinh an toàn thực phẩm 100%.</p>
                </div>
                <div class="col-md-3">
                    <h6 class="fw-bold text-white mb-3">Liên kết nhanh</h6>
                    <ul class="list-unstyled text-white-50 small lh-lg">
                        <li><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none hover-white"><i class="fa-solid fa-angle-right me-1"></i> Trang chủ</a></li>
                        <li><a asp-controller="Cart" asp-action="Index" class="text-white-50 text-decoration-none hover-white"><i class="fa-solid fa-angle-right me-1"></i> Giỏ hàng</a></li>
                        <li><a asp-controller="Account" asp-action="Login" class="text-white-50 text-decoration-none hover-white"><i class="fa-solid fa-angle-right me-1"></i> Đăng nhập</a></li>
                        <li><a asp-controller="Account" asp-action="Register" class="text-white-50 text-decoration-none hover-white"><i class="fa-solid fa-angle-right me-1"></i> Đăng ký</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
