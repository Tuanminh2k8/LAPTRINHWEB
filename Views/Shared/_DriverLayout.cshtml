@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Source.Helpers
@using Source.Models
@{
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? HttpContextAccessor.HttpContext?.User.FindFirst("FullName")?.Value ?? "Tài xế";
    var pageTitle = (ViewData["Title"]?.ToString() ?? "Kênh Tài Xế") + " - PolyFood Store";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" onload="this.media='all'" />
    <noscript>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    </noscript>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @Html.AntiForgeryToken()
    <style>
        :root { --driver-primary: #1a73e8; --driver-bg: #f5f6fa; --driver-sidebar-width: 240px; }
        body { background-color: var(--driver-bg); font-family: 'Plus Jakarta Sans', sans-serif; }
        .driver-sidebar {
            background: #fff; box-shadow: 2px 0 10px rgba(0,0,0,.05);
            border-right: 1px solid #e5e7eb;
        }
        .driver-nav-link {
            display: flex; align-items: center; padding: 12px 20px;
            color: #333; font-weight: 500; text-decoration: none;
            border-radius: 8px; margin: 4px 12px; transition: all .2s;
        }
        .driver-nav-link:hover { background: #f0f4ff; color: var(--driver-primary); }
        .driver-nav-link.active { background: #e8f0fe; color: var(--driver-primary); }
        .driver-online-dot { width: 10px; height: 10px; border-radius: 50%; background: #22c55e; display: inline-block; }
        .online-badge { background: #ecfdf5; color: #059669; }
    </style>
</head>
<body>
    <div class="d-flex" style="min-height:100vh;">
        <!-- Sidebar -->
        <aside class="driver-sidebar d-none d-lg-flex flex-column" style="width:var(--driver-sidebar-width);flex-shrink:0;">
            <div class="p-3 border-bottom d-flex align-items-center gap-2">
                <span class="rounded-3 bg-dark text-white d-flex align-items-center justify-content-center" style="width:38px;height:38px;"><i class="fa-solid fa-motorcycle"></i></span>
                <div>
                    <div class="fw-bold">PolyFood</div>
                    <div class="small text-muted">Kênh Tài Xế</div>
                </div>
            </div>
            <nav class="py-2 flex-grow-1">
                <a class="driver-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Driver" asp-action="Index">
                    <i class="fa-solid fa-gauge-high me-2"></i> Tổng quan
                </a>
                <a class="driver-nav-link" href="/Driver/Index#activeOrders">
                    <i class="fa-solid fa-truck-fast me-2"></i> Đơn đang giao
                </a>
            </nav>
            <div class="p-3 border-top">
                <div class="small text-muted mb-2">Đang trực tuyến</div>
                <div class="d-flex align-items-center gap-2 online-badge rounded-pill px-3 py-2">
                    <span class="driver-online-dot"></span>
                    <span class="fw-bold small" id="driverOnlineLabel">Online</span>
                </div>
                <div class="mt-3 d-grid gap-2">
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary btn-sm rounded-pill">
                        <i class="fa-solid fa-right-from-bracket me-1"></i> Đăng xuất
                    </a>
                </div>
            </div>
        </aside>

        <!-- Mobile topbar -->
        <div class="d-lg-none w-100">
            <nav class="navbar navbar-expand bg-white shadow-sm mb-3">
                <div class="container-fluid">
                    <span class="fw-bold"><i class="fa-solid fa-motorcycle me-1 text-primary"></i>PolyFood Tài Xế</span>
                    <div class="d-flex gap-2">
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-right-from-bracket"></i></a>
                    </div>
                </div>
            </nav>
            <div class="container-fluid">
                @RenderBody()
            </div>
        </div>
        <div class="d-none d-lg-block flex-grow-1" style="padding:24px;">
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>