@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Trị Hệ Thống - PolyFood</title>
    
    <!-- Bootstrap and Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Source.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
            <div class="container-fluid px-4">
                <a class="navbar-brand text-danger fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-hamburger"></i> PolyFood Admin
                </a>
                <div class="d-flex align-items-center text-white">
                    <i class="fa-solid fa-user-shield me-2 text-warning"></i>
                    <span class="me-3">Admin: <strong>@fullName</strong></span>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                        <i class="fa-solid fa-right-from-bracket me-1"></i> Đăng xuất
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid" style="margin-top: 56px;">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3 col-lg-2 p-0">
                <div class="admin-sidebar">
                    <div class="text-center mb-4">
                        <i class="fa-solid fa-user-gear fa-3x text-warning"></i>
                        <h6 class="mt-2 text-white">QUẢN TRỊ VIÊN</h6>
                        <hr class="text-white-50">
                    </div>
                    
                    <nav class="nav flex-column">
                        <a class="nav-link-admin @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                            <i class="fa-solid fa-chart-line"></i> Bảng điều khiển
                        </a>
                        <a class="nav-link-admin @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" || ViewContext.RouteData.Values["action"]?.ToString()?.Contains("User") == true ? "active" : "")" asp-controller="Admin" asp-action="Users">
                            <i class="fa-solid fa-users"></i> Quản lý người dùng
                        </a>
                        <a class="nav-link-admin @(ViewContext.RouteData.Values["action"]?.ToString() == "Foods" || ViewContext.RouteData.Values["action"]?.ToString()?.Contains("Food") == true ? "active" : "")" asp-controller="Admin" asp-action="Foods">
                            <i class="fa-solid fa-bowl-food"></i> Quản lý món ăn
                        </a>
                        <a class="nav-link-admin @(ViewContext.RouteData.Values["action"]?.ToString() == "Combos" || ViewContext.RouteData.Values["action"]?.ToString()?.Contains("Combo") == true ? "active" : "")" asp-controller="Admin" asp-action="Combos">
                            <i class="fa-solid fa-boxes-packing"></i> Quản lý Combo
                        </a>
                        <a class="nav-link-admin @(ViewContext.RouteData.Values["action"]?.ToString() == "Orders" || ViewContext.RouteData.Values["action"]?.ToString()?.Contains("Order") == true ? "active" : "")" asp-controller="Admin" asp-action="Orders">
                            <i class="fa-solid fa-receipt"></i> Quản lý đơn hàng
                        </a>
                        <hr class="text-white-50 my-3">
                        <a class="nav-link-admin" asp-controller="Home" asp-action="Index">
                            <i class="fa-solid fa-arrow-left-long"></i> Về trang khách
                        </a>
                    </nav>
                </div>
            </div>

            <!-- Content Area -->
            <div class="col-md-9 col-lg-10 p-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
                        <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
