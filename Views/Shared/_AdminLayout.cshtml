@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Source.Helpers
@using Source.Models
@{
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? HttpContextAccessor.HttpContext?.User.FindFirst("FullName")?.Value ?? "Admin";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var pageTitle = (ViewData["Title"]?.ToString() ?? "Trang chủ") + " - PolyFood Store";
    var siteDescription = "PolyFood - Hệ thống đặt thức ăn nhanh hàng đầu. Giao hàng siêu tốc trong 30 phút.";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@siteDescription" />
    <meta name="keywords" content="fast food, đồ ăn nhanh, pizza, burger, gà rán, đặt đồ ăn online, quản trị, admin" />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@siteDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/default_food.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@siteDescription" />
    <link rel="canonical" href="https://polyfood.example.com/admin" />
    <title>@pageTitle</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @Html.AntiForgeryToken()
</head>
<body class="bg-light">
    <!-- Mobile offcanvas sidebar -->
    <div class="offcanvas offcanvas-start d-lg-none text-white admin-sidebar-bg" tabindex="-1" id="adminSidebar" aria-label="Menu quản trị">
        <div class="offcanvas-header border-bottom border-white border-opacity-10">
            <h6 class="text-white fw-bold mb-0 d-flex align-items-center gap-2">
                <span class="brand-icon" style="width:32px;height:32px;font-size:.85rem;"><i class="fa-solid fa-burger"></i></span>
                PolyFood Admin
            </h6>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-3">
            <ul class="navbar-nav flex-column gap-1">
                <li class="nav-item">
                    <a class="nav-link nav-link-polyfood @(currentAction == "Index" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                        <i class="fa-solid fa-chart-line me-2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link nav-link-polyfood @(currentController == "Admin" && currentAction == "Users" ? "active" : "")" asp-controller="Admin" asp-action="Users">
                        <i class="fa-solid fa-users me-2"></i> Người dùng
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link nav-link-polyfood @(currentController == "Admin" && currentAction == "Categories" ? "active" : "")" asp-controller="Admin" asp-action="Categories">
                        <i class="fa-solid fa-list me-2"></i> Danh mục
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link nav-link-polyfood @(currentAction == "Foods" ? "active" : "")" asp-controller="Admin" asp-action="Foods">
                        <i class="fa-solid fa-burger me-2"></i> Món ăn
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link nav-link-polyfood @(currentAction == "ApiFoods" ? "active" : "")" asp-controller="Admin" asp-action="ApiFoods">
                        <i class="fa-solid fa-code me-2"></i> Quản lý món ăn
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link nav-link-polyfood @(currentAction == "Modifiers" ? "active" : "")" asp-controller="Admin" asp-action="Modifiers">
                        <i class="fa-solid fa-sliders me-2"></i> Tùy chọn món
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link nav-link-polyfood @(currentAction == "Combos" ? "active" : "")" asp-controller="Admin" asp-action="Combos">
                        <i class="fa-solid fa-boxes-packing me-2"></i> Combo
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link nav-link-polyfood @(currentAction == "Orders" ? "active" : "")" asp-controller="Admin" asp-action="Orders">
                        <i class="fa-solid fa-receipt me-2"></i> Đơn hàng
                    </a>
                </li>
                <li class="nav-item">
                    <hr class="dropdown-divider my-2">
                </li>
                <li class="nav-item">
                    <a class="nav-link nav-link-polyfood" asp-controller="Home" asp-action="Index">
                        <i class="fa-solid fa-globe me-2"></i> Xem trang khách
                    </a>
                </li>
            </ul>
        </div>

        <!-- Loading Overlay -->
        <div id="loadingOverlay" class="loading-overlay">
            <div class="loading-spinner"></div>
        </div>
    </div>

    <!-- Desktop sidebar -->
    <aside class="d-none d-lg-flex position-fixed top-0 start-0 bottom-0 flex-column text-white admin-sidebar-bg" style="width: 240px; z-index: 1030;">
        <div class="p-3 border-bottom border-white border-opacity-10 text-center">
            <a asp-controller="Admin" asp-action="Index" class="text-decoration-none">
                <div class="mx-auto mb-2 bg-danger text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-burger fs-5"></i>
                </div>
                <h6 class="text-white fw-bold mb-0" style="font-size: .9rem;">PolyFood Admin</h6>
                <span class="badge bg-danger mt-1" style="font-size: .65rem;">Administrator</span>
            </a>
        </div>
        <nav class="nav flex-column gap-1 p-3 flex-grow-1">
            <a class="nav-link nav-link-polyfood @(currentAction == "Index" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                <i class="fa-solid fa-chart-line me-2"></i> Dashboard
            </a>
            <a class="nav-link nav-link-polyfood @(currentController == "Admin" && currentAction == "Users" ? "active" : "")" asp-controller="Admin" asp-action="Users">
                <i class="fa-solid fa-users me-2"></i> Người dùng
            </a>
            <a class="nav-link nav-link-polyfood @(currentController == "Admin" && currentAction == "Categories" ? "active" : "")" asp-controller="Admin" asp-action="Categories">
                <i class="fa-solid fa-list me-2"></i> Danh mục
            </a>
            <a class="nav-link nav-link-polyfood @(currentAction == "Foods" ? "active" : "")" asp-controller="Admin" asp-action="Foods">
                <i class="fa-solid fa-burger me-2"></i> Món ăn
            </a>
            <a class="nav-link nav-link-polyfood @(currentAction == "ApiFoods" ? "active" : "")" asp-controller="Admin" asp-action="ApiFoods">
                <i class="fa-solid fa-code me-2"></i> Quản lý món ăn
            </a>
            <a class="nav-link nav-link-polyfood @(currentAction == "Modifiers" ? "active" : "")" asp-controller="Admin" asp-action="Modifiers">
                <i class="fa-solid fa-sliders me-2"></i> Tùy chọn món
            </a>
            <a class="nav-link nav-link-polyfood @(currentAction == "Combos" ? "active" : "")" asp-controller="Admin" asp-action="Combos">
                <i class="fa-solid fa-boxes-packing me-2"></i> Combo
            </a>
            <a class="nav-link nav-link-polyfood @(currentAction == "Orders" ? "active" : "")" asp-controller="Admin" asp-action="Orders">
                <i class="fa-solid fa-receipt me-2"></i> Đơn hàng
            </a>
            <hr class="border-white border-opacity-10 my-2">
            <a class="nav-link nav-link-polyfood" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-arrow-left-long me-2"></i> Về trang khách
            </a>
        </nav>
        <div class="p-3 border-top border-white border-opacity-10">
            <div class="d-flex align-items-center gap-2 text-white-50 small">
                <i class="fa-solid fa-circle-user text-danger fs-5"></i>
                <span class="text-truncate">@fullName</span>
            </div>
        </div>
    </aside>

    <!-- Mobile top bar -->
    <nav class="navbar navbar-dark bg-dark fixed-top shadow-sm d-flex d-lg-none" style="z-index: 1041; height: 56px;">
        <div class="container-fluid px-3">
            <button class="btn btn-outline-light border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-label="Mở menu">
                <i class="fa-solid fa-bars fs-5"></i>
            </button>
            <a class="navbar-brand fw-bold text-danger mb-0 small" asp-controller="Admin" asp-action="Index">
                <i class="fa-solid fa-burger me-1"></i> PolyFood
            </a>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-pill px-2 py-1">
                <i class="fa-solid fa-right-from-bracket"></i>
            </a>
        </div>
    </nav>

    <!-- Main content -->
    <div class="admin-content-area">
        <div class="p-4" style="min-height: 100vh;">
            <!-- Desktop top bar -->
            <div class="d-none d-lg-flex justify-content-between align-items-center mb-4 p-3 bg-white rounded-3 shadow-sm">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-circle-user text-danger fs-4"></i>
                    <div>
                        <small class="text-muted d-block" style="font-size: .75rem;">Xin chào,</small>
                        <strong class="text-dark">@fullName</strong>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                        <i class="fa-solid fa-globe me-1"></i> Xem trang khách
                    </a>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-danger btn-sm rounded-pill px-3">
                        <i class="fa-solid fa-right-from-bracket me-1"></i> Đăng xuất
                    </a>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center py-3 px-4" role="alert">
                    <i class="fa-solid fa-circle-check fs-5 me-2 text-success"></i>
                    <div class="fw-600 small">@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center py-3 px-4" role="alert">
                    <i class="fa-solid fa-circle-exclamation fs-5 me-2 text-danger"></i>
                    <div class="fw-600 small">@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            
            @RenderBody()
        </div>
    </div>

    <!-- Toast + Scroll top -->
    <div id="toastContainer" class="position-fixed bottom-0 end-0 p-3" style="z-index:1090"></div>
    <button id="btnScrollTop" class="btn-scroll-top" aria-label="Cuộn lên đầu trang">
        <i class="fa-solid fa-chevron-up"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
