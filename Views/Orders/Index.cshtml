@model IEnumerable<Source.Models.Order>
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Đơn Hàng Của Tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? HttpContextAccessor.HttpContext?.User.FindFirst("FullName")?.Value ?? "Khách hàng";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2" style="font-size: 1.75rem;">
                <span class="brand-icon" style="width:36px;height:36px;font-size:.85rem;"><i class="fa-solid fa-receipt"></i></span>
                Đơn Hàng Của Tôi
            </h1>
            <p class="text-muted mb-0 small">Xem lịch sử và theo dõi trạng thái các đơn hàng</p>
        </div>
        <a asp-controller="Home" asp-action="Menu" class="btn btn-danger btn-sm rounded-pill px-3">
            <i class="fa-solid fa-burger me-1"></i> Đặt thêm món
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 py-3 px-4 mb-4" role="alert">
            <i class="fa-solid fa-circle-check fs-5 me-2 text-success"></i>
            <div class="fw-600 small">@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 py-3 px-4 mb-4" role="alert">
            <i class="fa-solid fa-circle-exclamation fs-5 me-2 text-danger"></i>
            <div class="fw-600 small">@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5 py-md-6">
            <div class="bg-light rounded-4 p-4 p-md-5 d-inline-block" style="max-width: 400px;">
                <i class="fa-solid fa-receipt fa-4x text-muted mb-3"></i>
                <h3 class="fw-bold text-dark mb-2">Chưa có đơn hàng nào</h3>
                <p class="text-muted mb-4">Bạn chưa từng đặt hàng tại PolyFood. Hãy khám phá menu ngay hôm nay!</p>
                <a asp-controller="Home" asp-action="Menu" class="btn btn-danger rounded-pill px-4 py-2">
                    <i class="fa-solid fa-burger me-2"></i> Xem Menu & Đặt Hàng
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="text-muted small fw-500">Trạng thái:</span>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Tất cả <span class="badge bg-danger ms-1">@Model.Count()</span></a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Chờ xác nhận</a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Đang chuẩn bị</a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Đang giao</a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Đã giao</a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Đã hủy</a>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="min-width: 700px;">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 text-muted small fw-600 text-uppercase" style="width: 120px;">Mã đơn</th>
                            <th class="py-3 text-muted small fw-600 text-uppercase" style="width: 160px;">Ngày đặt</th>
                            <th class="py-3 text-muted small fw-600 text-uppercase">Món ăn / Combo</th>
                            <th class="py-3 text-muted small fw-600 text-uppercase" style="width: 120px;">Tổng tiền</th>
                            <th class="py-3 text-muted small fw-600 text-uppercase" style="width: 130px;">Trạng thái</th>
                            <th class="pe-4 py-3 text-muted small fw-600 text-uppercase" style="width: 120px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            var statusLabel = Source.Models.OrderStatus.GetLabel(order.Status);
                            var badgeClass = Source.Models.OrderStatus.GetBadgeClass(order.Status);
                            var subtotal = order.OrderDetails.Sum(d => (d.Price + d.Modifiers.Sum(m => m.OptionPrice)) * d.Quantity);
                            var grandTotal = subtotal + order.ShippingFee - order.Discount;
                            <tr>
                                <td class="ps-4 fw-600 text-dark">#@order.Id</td>
                                <td class="text-muted small">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        @foreach (var detail in order.OrderDetails)
                                        {
                                            var name = detail.FastFoodName ?? detail.FastFood?.Name ?? detail.Combo?.Name ?? "Sản phẩm";
                                            var img = detail.ProductImageUrl ?? detail.FastFood?.ImageUrl ?? detail.Combo?.ImageUrl ?? "/images/default_food.svg";
                                            <div class="d-flex align-items-center gap-2">
                                                <img src="@img" alt="@name" class="rounded-3" style="width: 36px; height: 36px; object-fit: cover;" />
                                                <div>
                                                    <div class="fw-500 small text-dark">@name</div>
                                                    <div class="text-muted small">x@detail.Quantity</div>
                                                    @if (detail.Modifiers.Any())
                                                    {
                                                        <div class="d-flex flex-wrap gap-1">
                                                            @foreach (var m in detail.Modifiers.Take(3))
                                                            {
                                                                <span class="badge bg-light border text-muted rounded-pill" style="font-size:.6rem;">@m.OptionName</span>
                                                            }
                                                            @if (detail.Modifiers.Count > 3)
                                                            {
                                                                <span class="badge bg-light border text-muted rounded-pill" style="font-size:.6rem;">+@(detail.Modifiers.Count - 3)</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td class="fw-600 text-danger" style="font-size:1rem;">@grandTotal.ToString("N0") ₫</td>
                                <td>
                                    <span class="badge @badgeClass px-3 py-2 small fw-500" style="font-size: .75rem;">@statusLabel</span>
                                </td>
                                <td class="pe-4">
                                    <div class="d-flex flex-column gap-1">
                                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1">
                                            <i class="fa-solid fa-eye me-1"></i> Xem chi tiết
                                        </a>
                                        @if (order.Status == "Pending" || order.Status == "Delivered")
                                        {
                                            <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3 py-1" data-bs-toggle="modal" data-bs-target="#rebuyModal@order.Id">
                                                <i class="fa-solid fa-repeat me-1"></i> Mua lại
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (ViewBag.TotalPages > 1)
            {
                <div class="card-footer bg-white border-0 p-3 p-md-4">
                    <nav aria-label="Phân trang đơn hàng">
                        <ul class="pagination pagination-sm justify-content-center mb-0 flex-wrap gap-1">
                            @{
                                var prevDisabled = ViewBag.CurrentPage <= 1 ? "disabled" : "";
                                var nextDisabled = ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "";
                            }
                            <li class="page-item @prevDisabled">
                                <a class="page-link rounded-3 px-3" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" aria-label="Trước">
                                    <i class="fa-solid fa-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                var active = i == ViewBag.CurrentPage ? "active" : "";
                                <li class="page-item @active">
                                    <a class="page-link rounded-3 px-3 @active" asp-action="Index" asp-route-page="@i">@i</a>
                                </li>
                            }
                            <li class="page-item @nextDisabled">
                                <a class="page-link rounded-3 px-3" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" aria-label="Sau">
                                    <i class="fa-solid fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    }
</div>

@foreach (var order in Model.Where(o => o.Status == "Pending"))
{
    <div class="modal fade" id="cancelModal@order.Id" tabindex="-1" aria-labelledby="cancelModalLabel@order.Id" aria-hidden="true" data-bs-keyboard="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <form asp-action="Cancel" asp-route-id="@order.Id" method="post" class="ajax-cancel-form" data-order-id="@order.Id">
                    <div class="modal-header bg-danger text-white rounded-top-4 border-0">
                        <h5 class="modal-title fw-600" id="cancelModalLabel@order.Id"><i class="fa-solid fa-triangle-exclamation me-2"></i>Xác nhận hủy đơn #@order.Id</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body p-4">
                        <p class="text-muted mb-3">Bạn có chắc chắn muốn hủy đơn hàng <strong>#@order.Id</strong> không? Hành động này không thể hoàn tác.</p>
                        <div class="mb-3">
                            <label for="cancelReason@order.Id" class="form-label fw-500 small">Lý do hủy (bắt buộc)</label>
                            <textarea class="form-control rounded-3" id="cancelReason@order.Id" name="cancelReason" rows="3" required placeholder="Nhập lý do hủy đơn hàng..."></textarea>
                            <div class="invalid-feedback">Vui lòng nhập lý do hủy đơn.</div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 bg-light rounded-bottom-4 p-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Giữ lại đơn hàng</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4" id="btnCancelConfirm@order.Id">
                            <i class="fa-solid fa-check me-1"></i> Xác nhận hủy
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
@foreach (var order in Model.Where(o => o.Status == "Pending" || o.Status == "Delivered"))
{
    <div class="modal fade" id="rebuyModal@order.Id" tabindex="-1" aria-labelledby="rebuyModalLabel@order.Id" aria-hidden="true" data-bs-keyboard="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <form asp-action="Rebuy" asp-route-id="@order.Id" method="post" class="ajax-rebuy-form" data-order-id="@order.Id">
                    <div class="modal-header bg-success text-white rounded-top-4 border-0">
                        <h5 class="modal-title fw-600" id="rebuyModalLabel@order.Id"><i class="fa-solid fa-repeat me-2"></i>Mua lại đơn hàng #@order.Id</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <p class="text-muted mb-3">Bạn có chắc chắn muốn mua lại đơn hàng <strong>#@order.Id</strong> không? Các món ăn trong đơn sẽ được thêm vào giỏ hàng.</p>
                        <div class="order-snapshot">
                            <h6>Sản phẩm trong đơn:</h6>
                            <div class="row g-3">
                                @foreach (var detail in order.OrderDetails.Take(5))
                                {
                                    <div class="col-12 col-sm-6">
                                        <div class="card border-0 p-3">
                                            <img src="@(detail.ProductImageUrl ?? detail.FastFood?.ImageUrl ?? "/images/default_food.svg")" class="rounded" style="width: 50px; height: 50px; object-fit: cover;" alt="@detail.FastFoodName">
                                            <div class="mt-2 small">
                                                <strong>@detail.FastFoodName ?? "Sản phẩm"</strong><br>
                                                <span>x@detail.Quantity</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (order.OrderDetails.Count > 5)
                                {
                                    <div class="col-12 text-center small text-muted">
                                        + @(order.OrderDetails.Count - 5) món khác
                                    </div>
                                }
                            </div>
                        </div>
                        <input type="hidden" name="rebuyNote" value="Mua lại đơn #@order.Id">
                    </div>
                    <div class="modal-footer border-0 bg-light rounded-bottom-4 p-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-success rounded-pill px-4">
                            <i class="fa-solid fa-check me-1"></i> Thêm vào giỏ hàng
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
@section Scripts {
        $(function () {
            document.querySelectorAll('[data-bs-toggle="modal"]').forEach(btn => {
                btn.addEventListener('click', function () {
                    const modalId = this.getAttribute('data-bs-target');
                    const modal = document.querySelector(modalId);
                    if (modal) {
                        modal.addEventListener('shown.bs.modal', function () {
                            modal.querySelector('textarea')?.focus();
                        }, { once: true });
                    }
                });
            });

            $(document).on('submit', '.ajax-cancel-form', function (e) {
                e.preventDefault();
                var $form = $(this);
                var $submitBtn = $form.find('button[type="submit"]');
                var originalHtml = $submitBtn.html();
                $submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status"></span> Đang xử lý...');
                $.ajax({
                    url: $form.attr('action'),
                    type: 'POST',
                    data: $form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (res) {
                        if (res.success || res.redirect) {
                            var modalId = '#cancelModal' + $form.data('order-id');
                            var modal = bootstrap.Modal.getInstance(document.querySelector(modalId));
                            if (modal) modal.hide();
                            PolyFood.showToast('Hủy đơn hàng thành công!', 'success');
                            setTimeout(function () { window.location.reload(); }, 1000);
                        } else {
                            PolyFood.showToast(res.message || 'Có lỗi xảy ra.', 'danger');
                        }
                    },
                    error: function (xhr) {
                        var msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : 'Có lỗi xảy ra. Vui lòng thử lại.';
                        PolyFood.showToast(msg, 'danger');
                    },
                    complete: function () {
                        $submitBtn.prop('disabled', false).html(originalHtml);
                    }
                });
            });

            // Handle rebuy form submit
            $(document).on('submit', '.ajax-rebuy-form', function (e) {
                e.preventDefault();
                var $form = $(this);
                var $submitBtn = $form.find('button[type="submit"]');
                var originalHtml = $submitBtn.html();
                $submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status"></span> Đang xử lý...');
                $.ajax({
                    url: $form.attr('action'),
                    type: 'POST',
                    data: $form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (res) {
                        if (res.success) {
                            var modalId = '#rebuyModal' + $form.data('order-id');
                            var modal = bootstrap.Modal.getInstance(document.querySelector(modalId));
                            if (modal) modal.hide();
                            PolyFood.showToast('Đã thêm món ăn vào giỏ hàng!', 'success');
                            setTimeout(function () { window.location.reload(); }, 1000);
                        } else {
                            PolyFood.showToast(res.message || 'Có lỗi xảy ra.', 'danger');
                        }
                    },
                    error: function (xhr) {
                        var msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : 'Có lỗi xảy ra. Vui lòng thử lại.';
                        PolyFood.showToast(msg, 'danger');
                    },
                    complete: function () {
                        $submitBtn.prop('disabled', false).html(originalHtml);
                    }
                });
            });
        });
    </script>
}

