@model Source.Models.Order
@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng #" + Model.Id;
    
    int activeStep = Model.Status switch
    {
        "Delivered" => 3,
        "Shipping" => 2,
        "Cancelled" => 0,
        "Refunded" => 0,
        _ => 1
    };
    int progressPercent = activeStep switch
    {
        3 => 100,
        2 => 50,
        _ => 15
    };
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <span class="brand-icon" style="width:36px;height:36px;font-size:.85rem;"><i class="fa-solid fa-route"></i></span>
                Theo Dõi Đơn Hàng #@Model.Id
            </h2>
            <span class="text-muted small">Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
        <a asp-action="Index" class="btn btn-secondary-custom btn-custom py-2 px-4" style="font-size:.85rem;">
            <i class="fa-solid fa-list me-1"></i> Tất cả đơn hàng
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5 mb-4">
        <h5 class="fw-bold text-dark mb-4">Trạng Thái Đơn Hàng</h5>
        
        <div class="timeline-status mb-4">
            <div class="timeline-track"></div>
            <div class="timeline-progress" style="width: @progressPercent%;"></div>
            <div class="timeline-steps">
                <div class="timeline-step @(activeStep >= 1 ? "active" : "")">
                    <div class="timeline-icon"><i class="fa-solid fa-receipt"></i></div>
                    <div class="timeline-text">Đã Tiếp Nhận</div>
                </div>
                <div class="timeline-step @(activeStep >= 2 ? "active" : "")">
                    <div class="timeline-icon"><i class="fa-solid fa-motorcycle"></i></div>
                    <div class="timeline-text">Đang Giao Hàng</div>
                </div>
                <div class="timeline-step @(activeStep >= 3 ? "active" : "")">
                    <div class="timeline-icon"><i class="fa-solid fa-circle-check"></i></div>
                    <div class="timeline-text">Đã Giao Thành Công</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <h5 class="fw-bold text-dark mb-3 pb-2" style="font-size:1rem;">Danh Sách Món Ăn</h5>
                
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr class="text-muted small">
                                <th>Món ăn</th>
                                <th class="text-center">Đơn giá</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Model.OrderDetails)
                            {
                                var name = detail.FastFoodName ?? detail.FastFood?.Name ?? detail.Combo?.Name ?? "Sản phẩm";
                                var img = detail.ProductImageUrl ?? detail.FastFood?.ImageUrl ?? detail.Combo?.ImageUrl ?? "/images/default_food.svg";
                                var modifierTotal = detail.Modifiers.Sum(m => m.OptionPrice);

                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@img" alt="@name" class="rounded-3" style="width: 42px; height: 42px; object-fit: cover;">
                                            <div>
                                                <div class="fw-bold text-dark" style="font-size:.85rem;">@name</div>
                                                @if (detail.Modifiers.Any())
                                                {
                                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                                        @foreach (var m in detail.Modifiers)
                                                        {
                                                            <span class="badge bg-light border text-muted rounded-pill" style="font-size:.65rem;">
                                                                @m.OptionName @(m.OptionPrice > 0 ? "+" + m.OptionPrice.ToString("N0") + "₫" : "")
                                                            </span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center small">@((detail.Price + modifierTotal).ToString("N0")) ₫</td>
                                    <td class="text-center fw-bold">x @detail.Quantity</td>
                                    <td class="text-end fw-bold text-danger small">@(((detail.Price + modifierTotal) * detail.Quantity).ToString("N0")) ₫</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <span class="fw-bold text-dark" style="font-size:1rem;">Tổng tiền thanh toán:</span>
                    <span class="fw-800 text-danger" style="font-size:1.4rem;">@Model.TotalAmount.ToString("N0") ₫</span>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <h5 class="fw-bold text-dark mb-3 pb-2" style="font-size:1rem;">Thông Tin Nhận Hàng</h5>
                
                <div class="mb-3">
                    <span class="text-muted small d-block">Người nhận hàng:</span>
                    <strong class="text-dark">@Model.ReceiverName</strong>
                </div>

                <div class="mb-3">
                    <span class="text-muted small d-block">Số điện thoại:</span>
                    <strong class="text-dark">@Model.ReceiverPhone</strong>
                </div>

                <div class="mb-3">
                    <span class="text-muted small d-block">@(Model.OrderType == "Pickup" ? "Hình thức nhận" : "Địa chỉ giao hàng"):</span>
                    @if (Model.OrderType == "Pickup")
                    {
                        <strong class="text-dark">Tự đến lấy tại cửa hàng @(Model.PickupTime.HasValue ? "— " + Model.PickupTime.Value.ToString("dd/MM HH:mm") : "")</strong>
                    }
                    else
                    {
                        <strong class="text-dark">@Model.ReceiverAddress</strong>
                    }
                </div>

                <div class="p-3 bg-light rounded-3 mt-4 border">
                    <span class="text-muted small d-block"><i class="fa-solid fa-shield-halved text-success me-1"></i>Trạng thái hiện tại:</span>
                    <strong class="text-danger" style="font-size:1.2rem;">@Source.Models.OrderStatus.GetLabel(Model.Status)</strong>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .timeline-status {
            position: relative;
        }
        .timeline-track {
            position: absolute;
            top: 24px;
            left: 20px;
            right: 20px;
            height: 3px;
            background: #e9ecef;
            border-radius: 2px;
        }
        .timeline-progress {
            position: absolute;
            top: 24px;
            left: 20px;
            height: 3px;
            background: linear-gradient(90deg, #dc3545, #ffc107);
            border-radius: 2px;
            transition: width 0.5s ease;
        }
        .timeline-steps {
            display: flex;
            justify-content: space-between;
            position: relative;
            z-index: 1;
            padding: 0 10px;
        }
        .timeline-step {
            display: flex;
            flex-direction: column;
            align-items: center;
            flex: 1;
            position: relative;
        }
        .timeline-icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #fff;
            border: 3px solid #dee2e6;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #adb5bd;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            z-index: 2;
        }
        .timeline-step.active .timeline-icon {
            border-color: #dc3545;
            background: #dc3545;
            color: #fff;
            box-shadow: 0 0 0 4px rgba(220, 53, 69, 0.15);
        }
        .timeline-text {
            margin-top: 8px;
            font-size: 0.75rem;
            font-weight: 600;
            color: #6c757d;
            text-align: center;
            white-space: nowrap;
        }
        .timeline-step.active .timeline-text {
            color: #dc3545;
        }
    </style>
}
