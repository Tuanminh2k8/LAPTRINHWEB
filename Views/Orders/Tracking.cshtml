@model Source.Models.Order
@{
    ViewData["Title"] = "Theo Dõi Đơn Hàng #" + Model.Id;
    var isLoggedIn = User.Identity?.IsAuthenticated ?? false;
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <span class="brand-icon" style="width:36px;height:36px;font-size:.85rem;"><i class="fa-solid fa-route"></i></span>
                Theo Dõi Đơn Hàng #@Model.Id
            </h2>
            <span class="text-muted small">Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
        <div class="d-flex gap-2">
            <span class="badge @Source.Models.OrderStatus.GetBadgeClass(Model.Status) fs-6" id="orderStatusBadge">
                @Source.Models.OrderStatus.GetLabel(Model.Status)
            </span>
            <a asp-action="Index" class="btn btn-secondary-custom btn-custom py-2 px-4" style="font-size:.85rem;">
                <i class="fa-solid fa-list me-1"></i> Tất cả đơn hàng
            </a>
        </div>
    </div>

    @if (!isLoggedIn)
    {
        <div class="alert alert-warning d-flex align-items-center gap-2">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>Đăng nhập để theo dõi trạng thái đơn hàng theo thời gian thực.</span>
        </div>
    }

    <!-- Connection state banner -->
    <div class="alert d-none align-items-center gap-2 mb-3" id="connBanner" role="alert">
        <span id="connDot" class="d-inline-block rounded-circle" style="width:10px;height:10px;"></span>
        <span id="connText"></span>
    </div>

    <div class="row g-4">
        <!-- Left: Map + driver -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
                <h5 class="fw-bold text-dark mb-3 pb-2" style="font-size:1rem;">
                    <i class="fa-solid fa-map-location-dot me-2 text-danger"></i>Bản Đồ Giao Hàng
                </h5>
                <div id="trackingMap" style="height:320px;border-radius:12px;background:#e9ecef;"></div>
                <div class="small text-muted mt-2" id="mapStatus">Bản đồ sẽ hiển thị vị trí tài xế khi đơn bắt đầu giao.</div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <h5 class="fw-bold text-dark mb-3 pb-2" style="font-size:1rem;">
                    <i class="fa-solid fa-user-gear me-2 text-danger"></i>Thông Tin Nhận Hàng
                </h5>
                <div class="mb-3">
                    <span class="text-muted small d-block">Người nhận hàng:</span>
                    <strong class="text-dark">@Model.ReceiverName</strong>
                </div>
                <div class="mb-3">
                    <span class="text-muted small d-block">Số điện thoại:</span>
                    <strong class="text-dark">@Model.ReceiverPhone</strong>
                </div>
                <div class="mb-3">
                    <span class="text-muted small d-block">@(Model.OrderType == "Pickup" ? "Hình thức nhận" : "Địa chỉ giao hàng"):</span>
                    @if (Model.OrderType == "Pickup")
                    {
                        <strong class="text-dark">Tự đến lấy tại cửa hàng @(Model.PickupTime.HasValue ? "— " + Model.PickupTime.Value.ToString("dd/MM HH:mm") : "")</strong>
                    }
                    else
                    {
                        <strong class="text-dark">@Model.ReceiverAddress</strong>
                    }
                </div>
            </div>
        </div>

        <!-- Right: Status timeline + driver card -->
        <div class="col-lg-5">
            <!-- Driver card -->
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
                <h5 class="fw-bold text-dark mb-3 pb-2" style="font-size:1rem;">
                    <i class="fa-solid fa-motorcycle me-2 text-danger"></i>Tài Xế Giao Hàng
                </h5>
                <div id="driverCard">
                    <div class="text-muted py-3"><i class="fa-solid fa-hourglass-half me-1"></i>Đang chờ gán tài xế...</div>
                </div>
                <div class="p-3 bg-light rounded-3 mt-3 border">
                    <span class="text-muted small d-block"><i class="fa-solid fa-shield-halved text-success me-1"></i>Trạng thái hiện tại:</span>
                    <strong class="text-danger" style="font-size:1.2rem;" id="currentStatusText">@Source.Models.OrderStatus.GetLabel(Model.Status)</strong>
                    @if (Model.EstimatedDeliveryTime.HasValue)
                    {
                        <div class="small text-muted mt-1"><i class="fa-regular fa-clock me-1"></i>Dự kiến giao: @Model.EstimatedDeliveryTime.Value.ToString("HH:mm dd/MM")</div>
                    }
                </div>
            </div>

            <!-- Timeline -->
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <h5 class="fw-bold text-dark mb-3 pb-2" style="font-size:1rem;">
                    <i class="fa-solid fa-timeline me-2 text-danger"></i>Chi Tiết Trạng Thái
                </h5>
                <div id="trackingTimeline">
                    <div class="text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm me-2"></div>Đang tải...
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
    <script>
        $(function () {
            const orderId = @Model.Id;
            const orderType = '@Model.OrderType';
            const token = $('input[name="__RequestVerificationToken"]').val();
            const initialStatus = '@Model.Status';

            let map = null;
            let marker = null;
            let circle = null;
            let conn = null;
            let currentStatus = initialStatus;

            // ---- Map helpers ----
            function initMap(lat, lng) {
                if (map) return;
                map = L.map('trackingMap').setView([lat, lng], 14);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap contributors'
                }).addTo(map);
                marker = L.marker([lat, lng], {
                    icon: L.divIcon({
                        className: 'driver-marker',
                        html: '<div style="width:34px;height:34px;border-radius:50%;background:#1a73e8;border:3px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.3);display:flex;align-items:center;justify-content:center;"><i class="fa-solid fa-motorcycle" style="color:#fff;font-size:15px;"></i></div>',
                        iconSize: [34, 34],
                        iconAnchor: [17, 17]
                    })
                }).addTo(map).bindPopup('Tài xế');
                circle = L.circle([lat, lng], { radius: 150, color: '#1a73e8', fillColor: '#1a73e8', fillOpacity: 0.08 }).addTo(map);
            }

            function updateMarker(lat, lng) {
                if (!map) initMap(lat, lng);
                if (marker) marker.setLatLng([lat, lng]);
                if (circle) circle.setLatLng([lat, lng]);
                if (map) map.panTo([lat, lng], { animate: true });
            }

            // ---- Connection state UI ----
            function setConn(state, text, color) {
                const $banner = $('#connBanner');
                $banner.removeClass('d-none alert-success alert-danger alert-warning');
                $banner.addClass('alert-' + color);
                $('#connDot').css('background', state === 'connected' ? '#22c55e' : state === 'reconnecting' ? '#f59e0b' : '#ef4444');
                $('#connText').text(text);
            }

            // ---- Timeline render ----
            function renderTimeline(events) {
                const $t = $('#trackingTimeline').empty();
                if (!events || !events.length) {
                    $t.html('<div class="text-muted text-center py-3">Chưa có sự kiện trạng thái.</div>');
                    return;
                }
                events.forEach(function (e, idx) {
                    const isLast = idx === events.length - 1;
                    $t.append(
                        '<div class="d-flex gap-3 pb-3" style="border-left:2px solid ' + (isLast ? '#dc3545' : '#e9ecef') + ';margin-left:12px;padding-left:16px;">' +
                        '<div><i class="fa-solid ' + e.icon + ' ' + (isLast ? 'text-danger' : 'text-secondary') + '"></i></div>' +
                        '<div>' +
                        '<div class="fw-bold" style="font-size:.9rem;">' + e.statusLabel + '</div>' +
                        '<div class="small text-muted">' + (e.description || '') + (e.actor ? ' — ' + e.actor : '') + '</div>' +
                        '<div class="small text-muted">' + new Date(e.createdAt).toLocaleString('vi-VN') + '</div>' +
                        '</div></div>'
                    );
                });
            }

            // ---- Driver card render ----
            function renderDriverCard(driver) {
                if (!driver) {
                    $('#driverCard').html('<div class="text-muted"><i class="fa-solid fa-hourglass-half me-1"></i>Đang chờ gán tài xế...</div>');
                    return;
                }
                $('#driverCard').html(
                    '<div class="d-flex align-items-center gap-3">' +
                    '<img src="' + (driver.avatarUrl || '/images/default_avatar.svg') + '" class="rounded-circle border" style="width:52px;height:52px;object-fit:cover;">' +
                    '<div>' +
                    '<div class="fw-bold text-dark">' + driver.fullName + '</div>' +
                    '<div class="small text-muted"><i class="fa-solid fa-star text-warning me-1"></i>' + (driver.rating || 5).toFixed(1) + ' · ' + driver.totalDeliveries + ' chuyến</div>' +
                    '<div class="small text-muted"><i class="fa-solid ' + (driver.vehicleType === 'Ô tô' ? 'fa-car' : 'fa-motorcycle') + ' me-1"></i>' + (driver.vehicleType || '') + (driver.licensePlate ? ' · ' + driver.licensePlate : '') + '</div>' +
                    '</div>' +
                    '<div class="ms-auto text-end small">' +
                    '<div class="text-muted mb-1">Liên hệ</div>' +
                    '<a href="tel:' + driver.phoneNumber + '" class="btn btn-sm btn-outline-primary rounded-pill"><i class="fa-solid fa-phone me-1"></i>Gọi</a>' +
                    '</div></div>'
                );
            }

            // ---- Data load ----
            async function loadTracking() {
                try {
                    const res = await fetch('/api/orders/' + orderId + '/tracking');
                    if (!res.ok) return;
                    const data = await res.json();

                    if (data.status && data.statusLabel) {
                        currentStatus = data.status;
                        $('#currentStatusText').text(data.statusLabel);
                        $('#orderStatusBadge').text(data.statusLabel);
                    }
                    if (data.estimatedDeliveryTime) {
                        $('.small.text-muted .fa-regular').closest('div').remove();
                    }
                    if (data.events) renderTimeline(data.events);
                    if (data.driver) renderDriverCard(data.driver);
                    if (data.driver && data.driver.hasLocation && data.driver.latitude && data.driver.longitude) {
                        updateMarker(data.driver.latitude, data.driver.longitude);
                        $('#mapStatus').text('Vị trí tài xế được cập nhật thời gian thực.');
                    }
                } catch (e) { /* ignore */ }
            }

            // ---- SignalR ----
            function connect() {
                conn = new signalR.HubConnectionBuilder()
                    .withUrl('/hubs/order-tracking')
                    .withAutomaticReconnect()
                    .build();

                conn.on('OrderStatusChanged', function (data) {
                    currentStatus = data.status;
                    $('#currentStatusText').text(data.statusLabel);
                    $('#orderStatusBadge').text(data.statusLabel);
                    loadTracking();
                });

                conn.on('DriverAssigned', function (data) {
                    renderDriverCard(data.driver);
                    loadTracking();
                });

                conn.on('DriverLocationUpdated', function (data) {
                    if (data.latitude && data.longitude) {
                        updateMarker(data.latitude, data.longitude);
                        $('#mapStatus').text('Vị trí tài xế được cập nhật thời gian thực · ' + new Date(data.at).toLocaleTimeString('vi-VN'));
                    }
                });

                conn.on('DriverAccepted', function () { loadTracking(); });
                conn.on('OrderDelivered', function () {
                    $('#currentStatusText').text('Đã giao thành công');
                    $('#orderStatusBadge').text('Đã giao');
                    loadTracking();
                });

                conn.onreconnecting(function () {
                    setConn('reconnecting', 'Mất kết nối. Đang kết nối lại...', 'warning');
                });
                conn.onreconnected(function () {
                    setConn('connected', 'Đã kết nối lại. Dữ liệu đang đồng bộ.', 'success');
                    // Sau reconnect ConnectionId mới → phải join lại group để nhận realtime
                    conn.invoke('JoinOrder', orderId).catch(function () { });
                    loadTracking();
                });
                conn.onclose(function () {
                    setConn('disconnected', 'Mất kết nối thời gian thực.', 'danger');
                });

                conn.start().then(function () {
                    setConn('connected', 'Kết nối thời gian thực thành công.', 'success');
                    return conn.invoke('JoinOrder', orderId);
                }).catch(function () {
                    setConn('disconnected', 'Không thể kết nối thời gian thực.', 'danger');
                });
            }

            if (@(isLoggedIn ? "true" : "false")) {
                loadTracking();
                connect();
            } else {
                // Không đăng nhập — không gọi API (cần auth) và không kết nối realtime;
                // chỉ hiển thị thông tin đơn hàng render từ server.
            }
        });
    </script>
}