@model List<Source.Models.CartItem>
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Giỏ Hàng";
    var isAuthenticated = HttpContextAccessor.HttpContext?.User.Identity?.IsAuthenticated == true;
}

@functions {
    string RowKey(Source.Models.CartItem item)
    {
        var optKey = string.Join("-", item.Modifiers.Select(m => m.OptionId));
        return item.IsCombo ? $"c{item.ComboId.GetValueOrDefault()}" : $"f{item.FastFoodId.GetValueOrDefault()}-{optKey}";
    }

    string CartStateLine(Source.Models.CartItem item)
    {
        var foodId = item.IsCombo ? "null" : (item.FastFoodId?.ToString() ?? "null");
        var comboId = item.IsCombo ? (item.ComboId?.ToString() ?? "null") : "null";
        var optionIds = string.Join(",", item.Modifiers.Select(m => m.OptionId));
        return $"{{ key: '{RowKey(item)}', foodId: {foodId}, comboId: {comboId}, optionIds: [{optionIds}], isCombo: {item.IsCombo.ToString().ToLower()} }},";
    }
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
            <span class="brand-icon" style="width:36px;height:36px;font-size:.85rem;"><i class="fa-solid fa-cart-shopping"></i></span>
            Giỏ Hàng
        </h2>
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary-custom btn-custom py-2 px-4" style="font-size:.85rem;">
            <i class="fa-solid fa-arrow-left me-1"></i> Tiếp tục mua hàng
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
            <div class="empty-state">
                <div class="empty-state-icon"><i class="fa-solid fa-basket-shopping"></i></div>
                <h5 class="empty-state-title">Giỏ hàng của bạn đang trống!</h5>
                <p class="empty-state-text">Hãy thêm những món ăn vô cùng thơm ngon từ PolyFood vào giỏ nhé.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom btn-custom px-4 py-3 rounded-pill shadow-sm">
                    <i class="fa-solid fa-utensils me-2"></i> Khám phá Menu Ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
                    <div class="table-responsive">
                        <table class="table cart-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Sản Phẩm</th>
                                    <th>Đơn Giá</th>
                                    <th class="text-center">Số Lượng</th>
                                    <th class="text-end">Thành Tiền</th>
                                    <th class="text-center">Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var rowKey = RowKey(item);
                                    <tr id="cart-row-@rowKey">
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@item.ImageUrl" alt="@item.Name" class="rounded-3 shadow-sm" style="width: 60px; height: 60px; object-fit: cover;" loading="lazy">
                                                <div>
                                                    <h6 class="fw-bold mb-0 text-dark" style="font-size:.9rem;">@item.Name</h6>
                                                    @if (item.IsCombo)
                                                    {
                                                        <span class="badge bg-warning text-dark rounded-pill small mt-1">Gói Combo</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-muted border rounded-pill small mt-1">Món lẻ</span>
                                                    }
                                                    @if (item.Modifiers.Any())
                                                    {
                                                        <div class="d-flex flex-wrap gap-1 mt-1">
                                                            @foreach (var m in item.Modifiers)
                                                            {
                                                                <span class="badge bg-light border text-muted rounded-pill small" style="font-size:.68rem;">
                                                                    @m.OptionName @(m.OptionPrice > 0 ? "+" + m.OptionPrice.ToString("N0") + "₫" : "")
                                                                </span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="fw-bold text-secondary" style="font-size:.9rem;">@item.UnitPrice.ToString("N0") ₫</td>
                                        <td class="text-center">
                                            <div class="quantity-control mx-auto" style="height:34px;">
                                                <button type="button" onclick="updateQuantity('@rowKey', @(item.Quantity - 1))" style="width:34px;height:34px;font-size:.85rem;">-</button>
                                                <input type="number" id="qty-input-@rowKey" value="@item.Quantity" readonly style="width:40px;height:34px;font-size:.85rem;">
                                                <button type="button" onclick="updateQuantity('@rowKey', @(item.Quantity + 1))" style="width:34px;height:34px;font-size:.85rem;">+</button>
                                            </div>
                                        </td>
                                        <td class="text-end fw-bold text-danger fs-6" id="item-total-@rowKey" style="font-size:1rem;">
                                            @item.TotalPrice.ToString("N0") ₫
                                        </td>
                                        <td class="text-center">
                                            <button onclick="removeItem('@rowKey')" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-2">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="p-3 bg-light d-flex justify-content-between align-items-center border-top">
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="clearCart()" style="font-size:.82rem;">
                            <i class="fa-solid fa-broom me-1"></i> Xóa toàn bộ
                        </button>
                        <span class="text-muted small">Tự động lưu giỏ hàng</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                    <h5 class="fw-bold text-dark mb-3 pb-2" style="font-size:1rem;">Tóm Tắt Đơn Hàng</h5>
                    
                    <div class="d-flex justify-content-between mb-2 text-secondary" style="font-size:.9rem;">
                        <span>Tổng số lượng:</span>
                        <strong id="cart-total-count" class="text-dark">@Model.Sum(i => i.Quantity) món</strong>
                    </div>

                    <div class="d-flex justify-content-between mb-3 text-secondary" style="font-size:.9rem;">
                        <span>Phí giao hàng:</span>
                        <span class="badge bg-success">Tính khi đặt</span>
                    </div>

                    <hr class="my-3">

                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold text-dark" style="font-size:1rem;">Tổng Tiền:</span>
                        <span class="fw-800 text-danger" id="cart-total-amount" style="font-size:1.4rem;">@Model.Sum(i => i.TotalPrice).ToString("N0") ₫</span>
                    </div>

                    <a asp-action="Checkout" class="btn btn-primary-custom btn-custom w-100 py-3 rounded-pill shadow" id="btnGoCheckout">
                        <i class="fa-solid fa-credit-card me-2"></i> Tiến Hành Thanh Toán
                    </a>
                    <p class="text-muted small text-center mt-2 mb-0">Khách vãng lai vẫn thanh toán được, không cần tài khoản.</p>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Dữ liệu gốc render từ server để thao tác giỏ bằng API
            var cartState = [
                @foreach (var item in Model ?? new List<Source.Models.CartItem>())
                {
                    @Html.Raw(CartStateLine(item))
                }
            ];

            function fmt(n) { return Number(n).toLocaleString('vi-VN') + ' ₫'; }
            function findItem(key) {
                return cartState.find(i => i.key === key) || null;
            }

            function reloadTotals() {
                $.getJSON('/api/cart')
                    .done(function (data) {
                        $('#cart-total-count').text(data.count + ' món');
                        $('#cart-total-amount').text(fmt(data.total));
                        var badge = $('#cart-badge');
                        if (data.isEmpty) { badge.addClass('d-none'); }
                        else { badge.text(data.count).removeClass('d-none'); }
                        // Cập nhật lại đơn giá/ thành tiền từng dòng
                        data.items.forEach(function (it) {
                            var optKey = (it.modifiers || []).map(m => m.optionId).join('-');
                            var key = it.isCombo ? 'c' + it.comboId : 'f' + it.fastFoodId + '-' + optKey;
                            var $total = $('#item-total-' + key);
                            if ($total.length) $total.text(fmt(it.totalPrice));
                            var $input = $('#qty-input-' + key);
                            if ($input.length) $input.val(it.quantity);
                        });
                    });
            }

            window.updateQuantity = function (key, newQty) {
                var item = findItem(key);
                if (!item) return;
                if (newQty < 0) newQty = 0;
                $.ajax({
                    url: '/api/cart/update',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        foodId: item.isCombo ? null : item.foodId,
                        comboId: item.isCombo ? item.comboId : null,
                        quantity: newQty,
                        optionIds: item.optionIds
                    }),
                    success: function (res) {
                        if (!res.success) return;
                        if (res.isEmpty) { location.reload(); return; }
                        if (newQty === 0) {
                            $('#cart-row-' + key).fadeOut(300, function () {
                                $(this).remove();
                                $('#cart-total-count').text(res.count + ' món');
                                $('#cart-total-amount').text(fmt(res.total));
                            });
                        } else {
                            $('#qty-input-' + key).val(newQty);
                            reloadTotals();
                        }
                    },
                    error: function (xhr) {
                        var msg = 'Có lỗi xảy ra. Vui lòng thử lại.';
                        if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                        showToast(msg, 'danger');
                    }
                });
            };

            window.removeItem = function (key) {
                if (!confirm('Bạn có chắc muốn xóa món này khỏi giỏ hàng?')) return;
                var item = findItem(key);
                if (!item) return;
                $.ajax({
                    url: '/api/cart/remove',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        foodId: item.isCombo ? null : item.foodId,
                        comboId: item.isCombo ? item.comboId : null,
                        optionIds: item.optionIds
                    }),
                    success: function (res) {
                        $('#cart-row-' + key).fadeOut(300, function () { $(this).remove(); });
                        refreshSummary(res);
                    },
                    error: function (xhr) {
                        var msg = 'Có lỗi xảy ra. Vui lòng thử lại.';
                        if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                        showToast(msg, 'danger');
                    }
                });
            };

            window.clearCart = function () {
                if (!confirm('Bạn có chắc muốn xóa tất cả sản phẩm trong giỏ hàng?')) return;
                $.ajax({
                    url: '/api/cart/clear',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({}),
                    success: function () { location.reload(); },
                    error: function () { showToast('Có lỗi xảy ra. Vui lòng thử lại.', 'danger'); }
                });
            };

            function refreshSummary(res) {
                $('#cart-total-count').text(res.count + ' món');
                $('#cart-total-amount').text(fmt(res.total));
                var badge = $('#cart-badge');
                if (res.count > 0) { badge.text(res.count).removeClass('d-none'); }
                else { badge.addClass('d-none'); if (res.isEmpty) { location.reload(); } }
                if (res.total !== undefined) {
                    showToast('Cập nhật giỏ hàng thành công.', 'success');
                }
            }
        });
    </script>
}