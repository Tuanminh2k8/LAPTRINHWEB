@model IEnumerable<Source.Models.Order>
@{
    ViewData["Title"] = "Lịch Sử Đặt Hàng";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
            <span class="brand-icon" style="width:36px;height:36px;font-size:.85rem;"><i class="fa-solid fa-clock-rotate-left"></i></span>
            Lịch Sử Đặt Hàng
        </h2>
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary-custom btn-custom py-2 px-4" style="font-size:.85rem;">
            <i class="fa-solid fa-utensils me-1"></i> Đặt thêm món
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
            <div class="empty-state">
                <div class="empty-state-icon"><i class="fa-solid fa-receipt"></i></div>
                <h5 class="empty-state-title">Bạn chưa có đơn hàng nào!</h5>
                <p class="empty-state-text">Hãy đặt món đầu tiên trên PolyFood Store ngay hôm nay.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom btn-custom rounded-pill px-4 py-2">
                    Khám phá Menu ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var order in Model)
            {
                <div class="col-12 reveal">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                        <div class="card-header bg-light p-3 d-flex flex-wrap align-items-center justify-content-between gap-2 border-0">
                            <div class="d-flex align-items-center gap-3">
                                <span class="fw-bold text-dark">Mã đơn: #@order.Id</span>
                                <span class="text-muted small"><i class="fa-solid fa-calendar me-1"></i>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div>
                                @if (order.Status == "Chưa giao")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="fa-solid fa-hourglass-start me-1"></i>@order.Status</span>
                                }
                                else if (order.Status == "Đang giao")
                                {
                                    <span class="badge bg-info text-dark px-3 py-2 rounded-pill"><i class="fa-solid fa-truck-fast me-1"></i>@order.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i>@order.Status</span>
                                }
                            </div>
                        </div>

                        <div class="card-body p-4">
                            <div class="row align-items-center">
                                <div class="col-md-7">
                                    <p class="mb-1 text-muted small"><i class="fa-solid fa-user me-2"></i>Người nhận: <strong class="text-dark">@order.ReceiverName</strong></p>
                                    <p class="mb-1 text-muted small"><i class="fa-solid fa-phone me-2"></i>SĐT: <strong class="text-dark">@order.ReceiverPhone</strong></p>
                                    <p class="mb-0 text-muted small"><i class="fa-solid fa-location-dot me-2"></i>Địa chỉ: <strong class="text-dark">@order.ReceiverAddress</strong></p>
                                </div>
                                <div class="col-md-5 text-md-end mt-3 mt-md-0">
                                    <div class="text-muted small">Tổng tiền đơn hàng:</div>
                                    <div class="fw-800 text-danger" style="font-size:1.5rem;">@order.TotalAmount.ToString("N0") ₫</div>
                                    <a asp-action="OrderTracking" asp-route-id="@order.Id" class="btn btn-outline-danger btn-sm rounded-pill px-4 fw-600 mt-2">
                                        <i class="fa-solid fa-eye me-1"></i> Theo dõi
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
