@model Source.Models.Order
@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng #" + Model.Id;
    
    int activeStep = Model.Status == "Đã giao" ? 3 : (Model.Status == "Đang giao" ? 2 : 1);
    int progressPercent = activeStep == 3 ? 100 : (activeStep == 2 ? 50 : 15);
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-route text-danger me-2"></i>Theo Dõi Đơn Hàng #@Model.Id
            </h2>
            <span class="text-muted small">Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
        <a asp-action="OrderHistory" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="fa-solid fa-list me-1"></i> Tất cả đơn hàng
        </a>
    </div>

    <!-- Timeline Tracking -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5 mb-4">
        <h5 class="fw-bold text-dark mb-4">Trạng Thái Đơn Hàng</h5>
        
        <div class="timeline-status mb-4">
            <div class="timeline-track"></div>
            <div class="timeline-progress" style="width: @progressPercent%;"></div>
            <div class="timeline-steps">
                <div class="timeline-step @(activeStep >= 1 ? "active" : "")">
                    <div class="timeline-icon"><i class="fa-solid fa-receipt"></i></div>
                    <div class="timeline-text">Đã Tiếp Nhận</div>
                </div>
                <div class="timeline-step @(activeStep >= 2 ? "active" : "")">
                    <div class="timeline-icon"><i class="fa-solid fa-motorcycle"></i></div>
                    <div class="timeline-text">Đang Giao Hàng</div>
                </div>
                <div class="timeline-step @(activeStep >= 3 ? "active" : "")">
                    <div class="timeline-icon"><i class="fa-solid fa-circle-check"></i></div>
                    <div class="timeline-text">Đã Giao Thành Công</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Order details list -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">Danh Sách Món Ăn</h5>
                
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr class="text-muted small">
                                <th>Món ăn</th>
                                <th class="text-center">Đơn giá</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Model.OrderDetails)
                            {
                                var name = detail.FastFood?.Name ?? detail.Combo?.Name ?? "Sản phẩm";
                                var img = detail.FastFood?.ImageUrl ?? detail.Combo?.ImageUrl ?? "/images/default_food.svg";
                                
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@img" alt="@name" class="rounded-3" style="width: 45px; height: 45px; object-fit: cover;">
                                            <span class="fw-bold text-dark small">@name</span>
                                        </div>
                                    </td>
                                    <td class="text-center small">@detail.Price.ToString("N0") ₫</td>
                                    <td class="text-center fw-bold">x @detail.Quantity</td>
                                    <td class="text-end fw-bold text-danger small">@((detail.Price * detail.Quantity).ToString("N0")) ₫</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <span class="fs-5 fw-bold text-dark">Tổng tiền thanh toán:</span>
                    <span class="fs-4 fw-800 text-danger">@Model.TotalAmount.ToString("N0") ₫</span>
                </div>
            </div>
        </div>

        <!-- Receiver Info -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">Thông Tin Nhận Hàng</h5>
                
                <div class="mb-3">
                    <span class="text-muted small d-block">Người nhận hàng:</span>
                    <strong class="text-dark fs-6">@Model.ReceiverName</strong>
                </div>

                <div class="mb-3">
                    <span class="text-muted small d-block">Số điện thoại:</span>
                    <strong class="text-dark fs-6">@Model.ReceiverPhone</strong>
                </div>

                <div class="mb-3">
                    <span class="text-muted small d-block">Địa chỉ giao hàng:</span>
                    <strong class="text-dark fs-6">@Model.ReceiverAddress</strong>
                </div>

                <div class="p-3 bg-light rounded-3 mt-4 border">
                    <span class="text-muted small d-block"><i class="fa-solid fa-shield-halved text-success me-1"></i>Trạng thái hiện tại:</span>
                    <strong class="text-danger fs-5">@Model.Status</strong>
                </div>
            </div>
        </div>
    </div>
</div>
