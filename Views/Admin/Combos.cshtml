@model IEnumerable<Source.Models.Combo>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Combo";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Quản Lý Gói Combo</h3>
        <p class="text-muted small mb-0">Quản lý các gói combo ưu đãi</p>
    </div>
    <a asp-action="ComboCreate" class="btn btn-primary-custom btn-custom rounded-pill px-4 py-2">
        <i class="fa-solid fa-plus me-2"></i> Thêm Combo Mới
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="bg-dark text-white">
                <tr>
                    <th>Hình Ảnh</th>
                    <th>Tên Combo</th>
                    <th>Món Ăn Bao Gồm</th>
                    <th>Giá Bán</th>
                    <th class="text-center">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var combo in Model)
                {
                    <tr>
                        <td>
                            <img src="@combo.ImageUrl" alt="@combo.Name" class="rounded-3 shadow-sm" style="width: 55px; height: 55px; object-fit: cover;" loading="lazy">
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@combo.Name</div>
                            <div class="small text-muted text-truncate" style="max-width: 250px;">@combo.Description</div>
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var detail in combo.ComboDetails)
                                {
                                    <span class="badge bg-light text-dark border small">@detail.FastFood?.Name (x@detail.Quantity)</span>
                                }
                            </div>
                        </td>
                        <td class="fw-bold text-danger">@combo.Price.ToString("N0") ₫</td>
                        <td class="text-center">
                            <a asp-action="ComboEdit" asp-route-id="@combo.Id" class="btn btn-sm btn-outline-primary border-0 rounded-circle p-2 me-1" title="Sửa">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <form asp-action="ComboDelete" asp-route-id="@combo.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa combo này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-2" title="Xóa">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" />
</div>
