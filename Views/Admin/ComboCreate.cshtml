@model Source.Models.Combo
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thêm Combo Mới";
    var foods = ViewBag.Foods as IEnumerable<Source.Models.FastFood> ?? new List<Source.Models.FastFood>();
}

<div class="mb-4">
    <h3 class="fw-bold text-dark mb-1">Thêm Gói Combo Mới</h3>
    <a asp-action="Combos" class="text-muted small text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i> Trở về danh sách</a>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5">
    <form asp-action="ComboCreate" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 py-2 small mb-3"></div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label fw-bold small text-muted"></label>
                <input asp-for="Name" class="form-control form-control-custom" placeholder="Nhập tên combo..." />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Price" class="form-label fw-bold small text-muted"></label>
                <input asp-for="Price" type="number" step="1000" class="form-control form-control-custom" placeholder="Nhập giá combo (₫)..." />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold small text-muted">Hình ảnh Combo</label>
            <input type="file" name="imageFile" class="form-control form-control-custom" accept="image/*" />
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="form-label fw-bold small text-muted"></label>
            <textarea asp-for="Description" class="form-control form-control-custom" rows="3" placeholder="Nhập mô tả gói combo..."></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="mb-4 p-3 bg-light rounded-3 border">
            <h6 class="fw-bold text-dark mb-3">Chọn các món lẻ thuộc Combo này:</h6>
            <div class="row g-3">
                @foreach (var food in foods)
                {
                    <div class="col-md-6">
                        <div class="d-flex align-items-center justify-content-between p-2 border bg-white rounded-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="selectedFoods" value="@food.Id" id="food_@food.Id">
                                <label class="form-check-label fw-600 small" for="food_@food.Id">
                                    @food.Name (@food.Price.ToString("N0") ₫)
                                </label>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <span class="small text-muted">SL:</span>
                                <input type="number" name="foodQuantities" value="1" min="1" max="10" class="form-control form-control-sm text-center" style="width: 60px;">
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <a asp-action="Combos" class="btn btn-secondary-custom btn-custom">Hủy bỏ</a>
            <button type="submit" class="btn btn-primary-custom btn-custom rounded-pill px-4">Lưu Combo</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
