@model IEnumerable<PromoCode>
@{
    ViewData["Title"] = "Quản lý Khuyến mãi";
    var kpi = ViewBag.Kpi as dynamic;
    var status = (string)ViewBag.Status ?? "All";
    var search = (string)ViewBag.Search;
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1" style="font-family:'Plus Jakarta Sans',sans-serif;">
                <i class="fa-solid fa-ticket text-danger me-2"></i>Quản lý Khuyến mãi
            </h2>
            <p class="text-muted mb-0">Tạo, duyệt và theo dõi mã giảm giá &amp; chương trình khuyến mãi.</p>
        </div>
        <a class="btn btn-primary-custom rounded-3" asp-action="PromotionCreate">
            <i class="fa-solid fa-plus me-1"></i> Tạo mã mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-3 border-0 shadow-sm">
            <i class="fa-solid fa-circle-check me-1"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-2">
            <div class="card rounded-4 border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-4 fw-bold">@kpi?.Total</div>
                    <div class="small text-muted">Tổng mã</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card rounded-4 border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-4 fw-bold text-success">@kpi?.Active</div>
                    <div class="small text-muted">Đang hoạt động</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card rounded-4 border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-4 fw-bold text-warning">@kpi?.Scheduled</div>
                    <div class="small text-muted">Đã lên lịch</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card rounded-4 border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-4 fw-bold text-secondary">@kpi?.Expired</div>
                    <div class="small text-muted">Hết hạn</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card rounded-4 border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-4 fw-bold">@kpi?.TotalUsed</div>
                    <div class="small text-muted">Lượt dùng</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card rounded-4 border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-4 fw-bold text-danger">@(string.Format("{0:N0}", kpi?.TotalDiscount ?? 0) + "₫")</div>
                    <div class="small text-muted">Tổng giảm</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card rounded-4 border-0 shadow-sm">
        <div class="card-body">
            <form method="get" class="row g-2 mb-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label small text-muted mb-1">Tìm kiếm</label>
                    <input type="text" name="search" value="@search" class="form-control rounded-3" placeholder="Mã hoặc tên khuyến mãi..." />
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-muted mb-1">Trạng thái</label>
                    <select name="status" class="form-select rounded-3">
                        <option value="All" selected="@(status == "All")">Tất cả</option>
                        <option value="Draft" selected="@(status == "Draft")">Nháp</option>
                        <option value="Scheduled" selected="@(status == "Scheduled")">Đã lên lịch</option>
                        <option value="Active" selected="@(status == "Active")">Đang hoạt động</option>
                        <option value="Paused" selected="@(status == "Paused")">Tạm dừng</option>
                        <option value="Expired" selected="@(status == "Expired")">Hết hạn</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-dark rounded-3 w-100">
                        <i class="fa-solid fa-filter me-1"></i> Lọc
                    </button>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>Mã</th>
                            <th>Tên</th>
                            <th>Loại</th>
                            <th>Giá trị</th>
                            <th>Thời gian</th>
                            <th>Đã dùng</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">Chưa có mã giảm giá nào.</td>
                            </tr>
                        }
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold font-monospace">@p.Code</span>
                                    @if (p.IsFeatured) { <span class="badge bg-danger-subtle text-danger ms-1">Nổi bật</span> }
                                </td>
                                <td>@p.Name</td>
                                <td>
                                    @if (p.DiscountType == "Percent")
                                    { <span class="badge bg-info-subtle text-info">%</span> }
                                    else
                                    { <span class="badge bg-primary-subtle text-primary">Tiền</span> }
                                </td>
                                <td>
                                    @if (p.DiscountType == "Percent")
                                    { @(p.DiscountValue + "%") }
                                    else
                                    { @(string.Format("{0:N0}", p.DiscountValue) + "₫") }
                                </td>
                                <td>
                                    <div class="small">@p.StartDate.ToString("dd/MM/yy HH:mm")</div>
                                    <div class="small text-muted">→ @(p.EndDate?.ToString("dd/MM/yy HH:mm") ?? "—")</div>
                                </td>
                                <td>@p.UsedCount.ToString("N0")</td>
                                <td>
                                    @{
                                        var badge = p.Status switch
                                        {
                                            nameof(PromotionStatus.Active) => "bg-success",
                                            nameof(PromotionStatus.Scheduled) => "bg-warning text-dark",
                                            nameof(PromotionStatus.Paused) => "bg-secondary",
                                            nameof(PromotionStatus.Expired) => "bg-light text-muted border",
                                            _ => "bg-light text-muted border"
                                        };
                                    }
                                    <span class="badge @badge">@p.Status</span>
                                    @if (!string.IsNullOrEmpty(p.Theme))
                                    {
                                        <span class="badge bg-dark-subtle text-dark ms-1" title="Chủ đề trang trí trang chủ">🎨 @p.Theme</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a class="btn btn-outline-dark rounded-start-3" asp-action="PromotionDetail" asp-route-id="@p.Id" title="Chi tiết">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a class="btn btn-outline-dark" asp-action="PromotionEdit" asp-route-id="@p.Id" title="Sửa">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        @if (p.Status == nameof(PromotionStatus.Draft) || p.Status == nameof(PromotionStatus.Scheduled))
                                        {
                                            <form asp-action="PromotionPublish" asp-route-id="@p.Id" method="post" class="d-inline">
                                                <button class="btn btn-outline-success" title="Duyệt & phát hành">
                                                    <i class="fa-solid fa-check"></i>
                                                </button>
                                            </form>
                                        }
                                        @if (p.Status == nameof(PromotionStatus.Active))
                                        {
                                            <form asp-action="PromotionPause" asp-route-id="@p.Id" method="post" class="d-inline">
                                                <button class="btn btn-outline-warning" title="Tạm dừng">
                                                    <i class="fa-solid fa-pause"></i>
                                                </button>
                                            </form>
                                        }
                                        @if (p.Status == nameof(PromotionStatus.Paused))
                                        {
                                            <form asp-action="PromotionActivate" asp-route-id="@p.Id" method="post" class="d-inline">
                                                <button class="btn btn-outline-success" title="Kích hoạt lại">
                                                    <i class="fa-solid fa-play"></i>
                                                </button>
                                            </form>
                                        }
                                        <form asp-action="PromotionEarlyPublish" asp-route-id="@p.Id" method="post" class="d-inline">
                                            <button class="btn btn-outline-info" title="Đẩy lên trước (hiển thị & dùng sớm)">
                                                <i class="fa-solid fa-arrow-up-right-dots"></i>
                                            </button>
                                        </form>
                                        <form asp-action="PromotionDelete" asp-route-id="@p.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Xóa mã @p.Code?');">
                                            <button class="btn btn-outline-danger rounded-end-3" title="Xóa">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
