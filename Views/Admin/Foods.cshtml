@model IEnumerable<Source.Models.FastFood>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Món Ăn";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Quản Lý Món Ăn</h3>
        <p class="text-muted small mb-0">Quản lý các món ăn lẻ trong thực đơn</p>
    </div>
    <a asp-action="FoodCreate" class="btn btn-primary-custom btn-custom rounded-pill px-4 py-2">
        <i class="fa-solid fa-plus me-2"></i> Thêm Món Ăn
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="bg-dark text-white">
                <tr>
                    <th>Hình Ảnh</th>
                    <th>Tên Món Ăn</th>
                    <th>Chủng Loại</th>
                    <th>Chủ Đề</th>
                    <th>Giá Bán</th>
                    <th class="text-center">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var food in Model)
                {
                    <tr>
                        <td>
                            <img src="@food.ImageUrl" alt="@food.Name" class="rounded-3 shadow-sm" style="width: 55px; height: 55px; object-fit: cover;" loading="lazy">
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@food.Name</div>
                            <div class="small text-muted text-truncate" style="max-width: 250px;">@food.Description</div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@food.Category?.Name</span>
                        </td>
                        <td>
                            <span class="badge bg-warning text-dark"><i class="fa-solid fa-tag me-1"></i>@food.Theme</span>
                        </td>
                        <td class="fw-bold text-danger">@food.Price.ToString("N0") ₫</td>
                        <td class="text-center">
                            <a asp-action="FoodEdit" asp-route-id="@food.Id" class="btn btn-sm btn-outline-primary border-0 rounded-circle p-2 me-1" title="Sửa">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <form asp-action="FoodDelete" asp-route-id="@food.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa món ăn này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-2" title="Xóa">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" />
</div>
