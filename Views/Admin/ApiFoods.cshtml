@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Món Ăn";
    var categories = (IEnumerable<dynamic>)ViewBag.ApiCategories;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Quản Lý Món Ăn</h3>
        <p class="text-muted small mb-0">Web API + AJAX: đọc dữ liệu từ <code>/api/foods</code> và thêm / cập nhật / xóa bằng JavaScript</p>
    </div>
    <button type="button" class="btn btn-primary-custom btn-custom rounded-pill px-4 py-2" id="btnToggleAddForm">
        <i class="fa-solid fa-plus me-2"></i> Thêm Món Ăn
    </button>
</div>

<div class="alert alert-info border-0 shadow-sm rounded-3 d-flex align-items-start py-3 px-4 mb-4" role="alert">
    <i class="fa-solid fa-circle-info fs-5 me-2 text-info mt-1"></i>
    <div class="small">
        <strong>Kiến trúc demo:</strong> bảng bên dưới được nạp trực tiếp từ các API công khai
        (<code>/api/foods</code>, <code>/api/categories</code>, <code>/api/combos</code>).
        Thêm / sửa / xóa gọi API có xác thực <code>Admin</code> qua <code>POST</code>, <code>PUT</code>, <code>DELETE</code> và bảo vệ bằng Anti-Forgery token.
    </div>
</div>

<!-- Thêm món ăn -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4 d-none" id="addFoodForm">
    <div class="card-header bg-dark text-white py-3">
        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-burger me-2"></i> Thêm Món Ăn Mới</h6>
    </div>
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-600 small">Tên món ăn <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="newFoodName" placeholder="VD: Burger Bò Phô Mai">
            </div>
            <div class="col-md-3">
                <label class="form-label fw-600 small">Giá (VNĐ) <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="newFoodPrice" min="0" step="1000" placeholder="55000">
            </div>
            <div class="col-md-3">
                <label class="form-label fw-600 small">Chủng loại <span class="text-danger">*</span></label>
                <select class="form-select" id="newFoodCategory">
                    <option value="">-- Chọn chủng loại --</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-600 small">Chủ đề</label>
                <input type="text" class="form-control" id="newFoodTheme" placeholder="VD: Ăn sáng, Tiệc tùng, Gia đình">
            </div>
            <div class="col-md-6">
                <label class="form-label fw-600 small">Ảnh (URL)</label>
                <input type="text" class="form-control" id="newFoodImageUrl" placeholder="/images/default_food.jpg">
            </div>
            <div class="col-12">
                <label class="form-label fw-600 small">Mô tả</label>
                <textarea class="form-control" id="newFoodDescription" rows="2" placeholder="Mô tả ngắn về món ăn..."></textarea>
            </div>
            <div class="col-12 text-end">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4 me-2" id="btnCancelAdd">Hủy</button>
                <button type="button" class="btn btn-primary-custom btn-custom rounded-pill px-4" id="btnSaveFood">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Lưu món ăn
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bảng danh sách -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
        <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-table-list me-2"></i> Danh sách món ăn (từ API)</h6>
        <span class="badge bg-success" id="foodCount">0 món</span>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="bg-dark text-white">
                <tr>
                    <th style="width:60px;">Hình Ảnh</th>
                    <th>Tên Món Ăn</th>
                    <th>Chủng Loại</th>
                    <th>Chủ Đề</th>
                    <th>Giá Bán</th>
                    <th class="text-center" style="width:120px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody id="foodTableBody">
                <tr><td colspan="6" class="text-center py-5 text-muted"><div class="spinner-border text-danger" role="status"></div><div class="mt-2 small">Đang tải dữ liệu...</div></td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Dữ liệu được nạp vào data-* để script render -->
<div class="d-none" id="apiDataContainer"
     data-foods="@System.Text.Json.JsonSerializer.Serialize(ViewBag.ApiFoods)"
     data-categories="@System.Text.Json.JsonSerializer.Serialize(ViewBag.ApiCategories)"
     data-combos="@System.Text.Json.JsonSerializer.Serialize(ViewBag.ApiCombos)"></div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var container = $('#apiDataContainer');
            var foods = JSON.parse(container.data('foods') || '[]');
            var categories = JSON.parse(container.data('categories') || '[]');
            var combos = JSON.parse(container.data('combos') || '[]');
            var csrfToken = $('input[name="__RequestVerificationToken"]').first().val() || '';

            var numberFmt = function (n) {
                return Number(n).toLocaleString('vi-VN') + ' ₫';
            };

            var categoryName = function (id) {
                var found = categories.find(function (c) { return c.id === id; });
                return found ? found.name : 'Khác';
            };

            var foodRow = function (f) {
                return '<tr data-id="' + f.id + '">' +
                    '<td><img src="' + f.imageUrl + '" alt="' + f.name + '" class="rounded-3 shadow-sm" style="width:55px;height:55px;object-fit:cover;" loading="lazy" onerror="this.src=\'/images/default_food.svg\';"></td>' +
                    '<td><div class="fw-bold text-dark">' + f.name + '</div>' +
                    '<div class="small text-muted text-truncate" style="max-width:250px;">' + (f.description || '') + '</div></td>' +
                    '<td><span class="badge bg-light text-dark border">' + categoryName(f.categoryId) + '</span></td>' +
                    '<td><span class="badge bg-warning text-dark"><i class="fa-solid fa-tag me-1"></i>' + (f.theme || '') + '</span></td>' +
                    '<td class="fw-bold text-danger">' + numberFmt(f.price) + '</td>' +
                    '<td class="text-center">' +
                    '<button type="button" class="btn btn-sm btn-outline-primary border-0 rounded-circle p-2 me-1 js-edit-food" title="Sửa" data-id="' + f.id + '"><i class="fa-solid fa-pen-to-square"></i></button>' +
                    '<button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-2 js-delete-food" title="Xóa" data-id="' + f.id + '"><i class="fa-solid fa-trash-can"></i></button>' +
                    '</td></tr>';
            };

            var renderTable = function () {
                var $body = $('#foodTableBody');
                if (!foods.length) {
                    $body.html('<tr><td colspan="6" class="text-center py-5 text-muted"><i class="fa-solid fa-burger me-2"></i>Chưa có món ăn nào.</td></tr>');
                } else {
                    $body.html(foods.map(foodRow).join(''));
                }
                $('#foodCount').text(foods.length + ' món');
            };

            var loadAllApi = function () {
                var remaining = 3;
                var done = function () { if (--remaining === 0) renderTable(); };
                $.getJSON('/api/categories').done(function (data) { categories = data; }).always(done);
                $.getJSON('/api/foods').done(function (data) { foods = data; }).always(done);
                $.getJSON('/api/combos').done(function (data) { combos = data; }).always(done);
            };

            var showComboSummary = function () {
                console.log('Combos from API:', combos.length);
                if (combos.length) {
                    window.showToast('Đã nạp ' + combos.length + ' combo từ /api/combos', 'info');
                }
            };

            $('#btnToggleAddForm').on('click', function () {
                $('#addFoodForm').toggleClass('d-none');
                if (!$('#addFoodForm').hasClass('d-none')) $('#newFoodName').trigger('focus');
            });

            $('#btnCancelAdd').on('click', function () {
                $('#addFoodForm').addClass('d-none');
                clearForm();
            });

            var clearForm = function () {
                $('#newFoodName, #newFoodPrice, #newFoodTheme, #newFoodImageUrl, #newFoodDescription').val('');
                $('#newFoodCategory').val('');
                $('#btnSaveFood').removeAttr('data-editing-id').html('<i class="fa-solid fa-floppy-disk me-1"></i> Lưu món ăn');
            };

            var setBusy = function (btn, busy, label) {
                if (busy) {
                    btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status"></span> ' + label);
                } else {
                    btn.prop('disabled', false).html(label);
                }
            };

            // Thêm hoặc cập nhật món ăn qua API
            $('#btnSaveFood').on('click', function () {
                var $btn = $(this);
                var editingId = $btn.attr('data-editing-id');
                var isEdit = !!editingId;

                var name = $('#newFoodName').val().trim();
                var price = parseFloat($('#newFoodPrice').val());
                var categoryId = parseInt($('#newFoodCategory').val(), 10);
                var theme = $('#newFoodTheme').val().trim();
                var imageUrl = $('#newFoodImageUrl').val().trim();
                var description = $('#newFoodDescription').val().trim();

                if (!name) { window.showToast('Vui lòng nhập tên món ăn.', 'warning'); return; }
                if (isNaN(price) || price < 0) { window.showToast('Giá tiền không hợp lệ.', 'warning'); return; }
                if (!categoryId) { window.showToast('Vui lòng chọn chủng loại.', 'warning'); return; }

                var payload = {
                    name: name,
                    price: price,
                    categoryId: categoryId,
                    theme: theme,
                    imageUrl: imageUrl,
                    description: description
                };

                setBusy($btn, true, 'Đang lưu...');

                $.ajax({
                    url: isEdit ? '/api/foods/' + editingId : '/api/foods',
                    type: isEdit ? 'PUT' : 'POST',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify(payload),
                    headers: { 'RequestVerificationToken': csrfToken },
                    success: function () {
                        clearForm();
                        $('#addFoodForm').addClass('d-none');
                        window.showToast(isEdit ? 'Cập nhật món ăn thành công!' : 'Thêm món ăn thành công!', 'success');
                        loadAllApi();
                    },
                    error: function (xhr) {
                        var msg = 'Có lỗi xảy ra. Vui lòng thử lại.';
                        try {
                            var res = JSON.parse(xhr.responseText);
                            if (res.message) msg = res.message;
                        } catch (e) { /* ignore */ }
                        window.showToast(msg, 'danger');
                    },
                    complete: function () { setBusy($btn, false, '<i class="fa-solid fa-floppy-disk me-1"></i> Lưu món ăn'); }
                });
            });

            // Mở form sửa
            $('#foodTableBody').on('click', '.js-edit-food', function () {
                var id = parseInt($(this).data('id'), 10);
                var f = foods.find(function (x) { return x.id === id; });
                if (!f) return;

                $('#newFoodName').val(f.name);
                $('#newFoodPrice').val(f.price);
                $('#newFoodCategory').val(f.categoryId);
                $('#newFoodTheme').val(f.theme);
                $('#newFoodImageUrl').val(f.imageUrl);
                $('#newFoodDescription').val(f.description || '');
                $('#btnSaveFood').attr('data-editing-id', id).html('<i class="fa-solid fa-floppy-disk me-1"></i> Cập nhật món ăn');
                $('#addFoodForm').removeClass('d-none');
                $('html, body').animate({ scrollTop: $('#addFoodForm').offset().top - 90 }, 400);
            });

            // Xóa món ăn qua API
            $('#foodTableBody').on('click', '.js-delete-food', function () {
                var id = parseInt($(this).data('id'), 10);
                var f = foods.find(function (x) { return x.id === id; });
                if (!f) return;

                if (!confirm('Bạn có chắc muốn xóa món "' + f.name + '"?')) return;

                $.ajax({
                    url: '/api/foods/' + id,
                    type: 'DELETE',
                    headers: { 'RequestVerificationToken': csrfToken },
                    success: function () {
                        window.showToast('Xóa món ăn thành công!', 'success');
                        loadAllApi();
                    },
                    error: function (xhr) {
                        var msg = 'Có lỗi xảy ra. Vui lòng thử lại.';
                        try {
                            var res = JSON.parse(xhr.responseText);
                            if (res.message) msg = res.message;
                        } catch (e) { /* ignore */ }
                        window.showToast(msg, 'danger');
                    }
                });
            });

            $(document).ready(function () {
                renderTable();
                showComboSummary();
            });
        })();
    </script>
}
