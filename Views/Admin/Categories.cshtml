@model IEnumerable<Source.Models.Category>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Danh Mục";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Quản Lý Danh Mục</h3>
        <p class="text-muted small mb-0">Quản lý các chủng loại món ăn</p>
    </div>
    <a asp-action="CategoryCreate" class="btn btn-primary-custom btn-custom rounded-pill px-4 py-2">
        <i class="fa-solid fa-plus me-2"></i> Thêm Danh Mục
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="bg-dark text-white">
                <tr>
                    <th>ID</th>
                    <th>Tên Danh Mục</th>
                    <th>Mô Tả</th>
                    <th class="text-center">Số Món Ăn</th>
                    <th class="text-center">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">Chưa có danh mục nào.</td>
                    </tr>
                }
                else
                {
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">#@cat.Id</td>
                            <td class="fw-bold text-dark">@cat.Name</td>
                            <td class="small text-muted">@cat.Description</td>
                            <td class="text-center">
                                <span class="badge bg-primary rounded-pill px-3 py-1">@(cat.FastFoods?.Count ?? 0)</span>
                            </td>
                            <td class="text-center">
                                <a asp-action="CategoryEdit" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-primary border-0 rounded-circle p-2 me-1" title="Sửa">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <form asp-action="CategoryDelete" asp-route-id="@cat.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa danh mục này? Các món ăn thuộc danh mục sẽ không bị xóa.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-2" title="Xóa">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
