@model Source.Models.Category
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thêm Danh Mục Mới";
}

<div class="mb-4">
    <h3 class="fw-bold text-dark mb-1">Thêm Danh Mục Mới</h3>
    <a asp-action="Categories" class="text-muted small text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i> Trở về danh sách</a>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5">
    <form asp-action="CategoryCreate" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 py-2 small mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-bold small text-muted"></label>
            <input asp-for="Name" class="form-control form-control-custom" placeholder="Nhập tên danh mục..." />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="form-label fw-bold small text-muted"></label>
            <textarea asp-for="Description" class="form-control form-control-custom" rows="3" placeholder="Nhập mô tả..."></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <a asp-action="Categories" class="btn btn-secondary-custom btn-custom">Hủy bỏ</a>
            <button type="submit" class="btn btn-primary-custom btn-custom rounded-pill px-4">Lưu Danh Mục</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
