@model Source.Models.Order
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi Tiết Đơn Hàng #" + Model.Id;
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h3 class="fw-bold text-dark mb-1">Chi Tiết Đơn Hàng #@Model.Id</h3>
        <a asp-action="Orders" class="text-muted small text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i> Trở về danh sách</a>
    </div>
    <span class="badge bg-danger fs-6 px-3 py-2 rounded-pill">@Model.Status</span>
</div>

<div class="row g-4">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
            <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">Thông Tin Người Nhận</h5>

            <div class="mb-2">
                <span class="text-muted small d-block">Tài khoản đặt hàng:</span>
                <strong class="text-dark">@(Model.User?.FullName ?? "Khách vãng lai") (@Model.User?.Username)</strong>
            </div>

            <div class="mb-2">
                <span class="text-muted small d-block">Người nhận:</span>
                <strong class="text-dark">@Model.ReceiverName</strong>
            </div>

            <div class="mb-2">
                <span class="text-muted small d-block">Số điện thoại:</span>
                <strong class="text-dark">@Model.ReceiverPhone</strong>
            </div>

            <div class="mb-2">
                <span class="text-muted small d-block">Địa chỉ:</span>
                <strong class="text-dark">@Model.ReceiverAddress</strong>
            </div>

            <div class="mb-0">
                <span class="text-muted small d-block">Thời gian đặt:</span>
                <span class="text-dark">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</span>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <h5 class="fw-bold text-dark mb-3">Cập Nhật Trạng Thái</h5>
            <form asp-action="UpdateOrderStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mb-3">
                    <select name="status" class="form-select form-control-custom">
                        <option value="Chưa giao" selected="@(Model.Status == "Chưa giao")">Chưa giao</option>
                        <option value="Đang giao" selected="@(Model.Status == "Đang giao")">Đang giao</option>
                        <option value="Đã giao" selected="@(Model.Status == "Đã giao")">Đã giao</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary-custom btn-custom w-100 rounded-pill py-2">
                    Lưu Trạng Thái
                </button>
            </form>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">Danh Sách Món Ăn</h5>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr class="text-muted small">
                            <th>Sản Phẩm</th>
                            <th class="text-center">Đơn Giá</th>
                            <th class="text-center">Số Lượng</th>
                            <th class="text-end">Thành Tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.OrderDetails)
                        {
                            var name = detail.FastFood?.Name ?? detail.Combo?.Name ?? "Sản phẩm";
                            var img = detail.FastFood?.ImageUrl ?? detail.Combo?.ImageUrl ?? "/images/default_food.svg";

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@img" alt="@name" class="rounded-3" style="width: 45px; height: 45px; object-fit: cover;" loading="lazy">
                                        <span class="fw-bold text-dark small">@name</span>
                                    </div>
                                </td>
                                <td class="text-center small">@detail.Price.ToString("N0") ₫</td>
                                <td class="text-center fw-bold">x @detail.Quantity</td>
                                <td class="text-end fw-bold text-danger small">@((detail.Price * detail.Quantity).ToString("N0")) ₫</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                <span class="fs-5 fw-bold text-dark">Tổng Tiền:</span>
                <span class="fs-4 fw-800 text-danger">@Model.TotalAmount.ToString("N0") ₫</span>
            </div>
        </div>
    </div>
</div>
