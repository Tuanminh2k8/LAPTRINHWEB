@model Source.Models.Order
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi Tiết Đơn Hàng #" + Model.Id;
    var statusBadgeClass = ViewBag.StatusBadgeClass as string ?? "bg-secondary";
    var statusLabel = ViewBag.StatusLabel as string ?? Model.Status;
    var subtotal = ViewBag.Subtotal as decimal? ?? 0;
    var grandTotal = ViewBag.GrandTotal as decimal? ?? Model.TotalAmount;
    int activeStep = Model.Status switch
    {
        "Pending" => 1,
        "Preparing" => 2,
        "Shipping" => 3,
        "Delivered" => 4,
        "Cancelled" => 0,
        "Refunded" => 0,
        _ => 1
    };
    int progressPercent = activeStep switch
    {
        4 => 100,
        3 => 66,
        2 => 33,
        1 => 10,
        _ => 0
    };
    string? nextAction = Model.Status switch
    {
        "Pending" => "ConfirmOrder",
        "Preparing" => "ShipOrder",
        "Shipping" => "DeliverOrder",
        _ => null
    };
    string nextActionLabel = Model.Status switch
    {
        "Pending" => "Xác nhận đơn hàng",
        "Preparing" => "Bắt đầu giao hàng",
        "Shipping" => "Đánh dấu đã giao",
        _ => ""
    };
}

<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="fa-solid fa-file-invoice text-danger me-2"></i>Chi Tiết Đơn Hàng #@Model.Id</h3>
        <a asp-action="Orders" class="text-muted small text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i> Trở về danh sách</a>
    </div>
    <div class="d-flex gap-2">
        <span class="badge fs-6 px-3 py-2 rounded-pill @statusBadgeClass">@statusLabel</span>
        <a asp-action="PrintInvoice" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-dark btn-sm rounded-pill px-3" title="In hóa đơn">
            <i class="fa-solid fa-print me-1"></i> In
        </a>
    </div>
</div>

@if (activeStep > 0)
{
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
        <h5 class="fw-bold text-dark mb-4">Theo dõi trạng thái đơn hàng</h5>
        <div class="timeline-status mb-2">
            <div class="timeline-track"></div>
            <div class="timeline-progress" style="width: @progressPercent%;"></div>
            <div class="timeline-steps">
                <div class="timeline-step @(activeStep >= 1 ? "active" : "")">
                    <div class="timeline-icon"><i class="fa-solid fa-clipboard-list"></i></div>
                    <div class="timeline-text">Chờ xác nhận</div>
                </div>
                <div class="timeline-step @(activeStep >= 2 ? "active" : "")">
                    <div class="timeline-icon"><i class="fa-solid fa-utensils"></i></div>
                    <div class="timeline-text">Đang chuẩn bị</div>
                </div>
                <div class="timeline-step @(activeStep >= 3 ? "active" : "")">
                    <div class="timeline-icon"><i class="fa-solid fa-truck-fast"></i></div>
                    <div class="timeline-text">Đang giao</div>
                </div>
                <div class="timeline-step @(activeStep >= 4 ? "active" : "")">
                    <div class="timeline-icon"><i class="fa-solid fa-circle-check"></i></div>
                    <div class="timeline-text">Đã giao</div>
                </div>
            </div>
        </div>
        @if (nextAction != null)
        {
            <form asp-action="@nextAction" method="post" class="mt-4 text-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger btn-custom rounded-pill px-4 py-2">
                    <i class="fa-solid fa-check me-2"></i>@nextActionLabel
                </button>
            </form>
        }
    </div>
}

<div class="row g-4">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
            <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">Thông Tin Khách Hàng</h5>
            <div class="mb-2">
                <span class="text-muted small d-block">Tài khoản:</span>
                <strong class="text-dark">@(Model.User?.FullName ?? "Khách vãng lai") (@Model.User?.Username)</strong>
            </div>
            <div class="mb-2">
                <span class="text-muted small d-block">Người nhận:</span>
                <strong class="text-dark">@Model.ReceiverName</strong>
            </div>
            <div class="mb-2">
                <span class="text-muted small d-block">Số điện thoại:</span>
                <strong class="text-dark">@Model.ReceiverPhone</strong>
            </div>
            <div class="mb-2">
                <span class="text-muted small d-block">Địa chỉ:</span>
                <strong class="text-dark">@Model.ReceiverAddress</strong>
            </div>
            <div class="mb-2">
                <span class="text-muted small d-block">Phương thức TT:</span>
                <strong class="text-dark">@(Model.PaymentMethod == "Bank" ? "Chuyển khoản ngân hàng" : "Thanh toán khi nhận hàng (COD)")</strong>
            </div>
            @if (!string.IsNullOrEmpty(Model.Note))
            {
                <div class="mb-2">
                    <span class="text-muted small d-block">Ghi chú:</span>
                    <strong class="text-dark">@Model.Note</strong>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.CancelReason))
            {
                <div class="mb-2">
                    <span class="text-muted small d-block">Lý do hủy:</span>
                    <strong class="text-danger">@Model.CancelReason</strong>
                </div>
            }
            <div class="mb-0">
                <span class="text-muted small d-block">Thời gian đặt:</span>
                <span class="text-dark">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</span>
            </div>
            @if (Model.UpdatedAt.HasValue)
            {
                <div class="mb-0">
                    <span class="text-muted small d-block">Cập nhật lần cuối:</span>
                    <span class="text-dark">@Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm:ss")</span>
                </div>
            }
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <h5 class="fw-bold text-dark mb-3">Thay đổi trạng thái</h5>
            <form asp-action="UpdateOrderStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mb-3">
                    <select name="status" class="form-select form-control-custom">
                        <option value="Pending" selected="@(Model.Status == "Pending")">Chờ xác nhận</option>
                        <option value="Preparing" selected="@(Model.Status == "Preparing")">Đang chuẩn bị</option>
                        <option value="Shipping" selected="@(Model.Status == "Shipping")">Đang giao</option>
                        <option value="Delivered" selected="@(Model.Status == "Delivered")">Đã giao</option>
                        <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Đã hủy</option>
                        <option value="Refunded" selected="@(Model.Status == "Refunded")">Hoàn tiền</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-danger btn-custom w-100 rounded-pill py-2">
                    Lưu trạng thái
                </button>
            </form>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">Danh Sách Món Ăn Đã Đặt</h5>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr class="text-muted small">
                            <th>Sản Phẩm</th>
                            <th class="text-center">Đơn Giá</th>
                            <th class="text-center">SL</th>
                            <th class="text-end">Thành Tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.OrderDetails)
                        {
                            var name = detail.FastFoodName ?? detail.FastFood?.Name ?? detail.Combo?.Name ?? "Sản phẩm";
                            var img = detail.ProductImageUrl ?? detail.FastFood?.ImageUrl ?? detail.Combo?.ImageUrl ?? "/images/default_food.svg";
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@img" alt="@name" class="rounded-3" style="width: 45px; height: 45px; object-fit: cover;" loading="lazy">
                                        <span class="fw-bold text-dark small">@name</span>
                                    </div>
                                </td>
                                <td class="text-center small">@detail.Price.ToString("N0") ₫</td>
                                <td class="text-center fw-bold">x @detail.Quantity</td>
                                <td class="text-end fw-bold text-danger small">@((detail.Price * detail.Quantity).ToString("N0")) ₫</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3 pt-3 border-top">
                <div class="d-flex justify-content-between mb-2 text-secondary">
                    <span>Tạm tính:</span>
                    <strong>@subtotal.ToString("N0") ₫</strong>
                </div>
                <div class="d-flex justify-content-between mb-2 text-secondary">
                    <span>Phí vận chuyển:</span>
                    <strong>@Model.ShippingFee.ToString("N0") ₫</strong>
                </div>
                <div class="d-flex justify-content-between mb-2 text-secondary">
                    <span>Giảm giá:</span>
                    <strong class="text-success">-@Model.Discount.ToString("N0") ₫</strong>
                </div>
                <div class="d-flex justify-content-between mt-3 pt-2 border-top">
                    <span class="fs-5 fw-bold text-dark">Tổng cộng:</span>
                    <span class="fs-4 fw-800 text-danger">@grandTotal.ToString("N0") ₫</span>
                </div>
            </div>
        </div>
    </div>
</div>
