@model Source.Models.Branch
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thêm Chi Nhánh";
}

<div class="mb-4">
    <h3 class="fw-bold text-dark mb-1">Thêm Chi Nhánh</h3>
    <a asp-action="Branches" class="text-muted small text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i> Trở về danh sách</a>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5">
    <form asp-action="BranchCreate" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 py-2 small mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold small text-muted"></label>
                    <input asp-for="Name" class="form-control form-control-custom" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Phone" class="form-label fw-bold small text-muted"></label>
                    <input asp-for="Phone" class="form-control form-control-custom" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
            </div>
            <div class="col-12">
                <div class="mb-3">
                    <label asp-for="Address" class="form-label fw-bold small text-muted"></label>
                    <input asp-for="Address" class="form-control form-control-custom" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="District" class="form-label fw-bold small text-muted"></label>
                    <input asp-for="District" class="form-control form-control-custom" />
                    <span asp-validation-for="District" class="text-danger small"></span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="mb-3">
                    <label asp-for="OpenTime" class="form-label fw-bold small text-muted"></label>
                    <input type="time" asp-for="OpenTime" class="form-control form-control-custom" />
                    <span asp-validation-for="OpenTime" class="text-danger small"></span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="mb-3">
                    <label asp-for="CloseTime" class="form-label fw-bold small text-muted"></label>
                    <input type="time" asp-for="CloseTime" class="form-control form-control-custom" />
                    <span asp-validation-for="CloseTime" class="text-danger small"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="SortOrder" class="form-label fw-bold small text-muted"></label>
                    <input asp-for="SortOrder" class="form-control form-control-custom" />
                    <span asp-validation-for="SortOrder" class="text-danger small"></span>
                </div>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" asp-for="IsActive" />
                    <label class="form-check-label fw-bold small text-muted" asp-for="IsActive"></label>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <a asp-action="Branches" class="btn btn-secondary-custom btn-custom">Hủy bỏ</a>
            <button type="submit" class="btn btn-primary-custom btn-custom rounded-pill px-4">Lưu Chi Nhánh</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
