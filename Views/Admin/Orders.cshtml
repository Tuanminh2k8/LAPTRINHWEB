        function confirmOrder(id) { ajaxPost('@Url.Action("ConfirmOrder", "Admin")', { id: id }, removeRow); }
        function shipOrder(id) { ajaxPost('@Url.Action("ShipOrder", "Admin")', { id: id }, removeRow); }
        function deliverOrder(id) { ajaxPost('@Url.Action("DeliverOrder", "Admin")', { id: id }, removeRow); }
        function cancelOrder(id) {
            if (!confirm('Bạn có chắc muốn hủy đơn hàng #' + id + '?')) return;
            ajaxPost('@Url.Action("CancelOrder", "Admin")', { id: id }, removeRow);
        }
        function deleteOrder(id) {
            if (!confirm('Bạn có chắc muốn xóa đơn hàng #' + id + '?')) return;
            ajaxPost('@Url.Action("DeleteOrder", "Admin")', { id: id }, removeRow);
        }

        function removeRow(res) {
            if (res && res.orderId) {
                $('#order-row-' + res.orderId).fadeOut(300, function () { $(this).remove(); });
            }
        }

        function showToast(message, type) {
            var toastHtml = '<div id="ajaxToast" class="toast align-items-center text-white bg-' + type + ' border-0 rounded-3 shadow show" style="z-index:1080">' +
                '<div class="d-flex">' +
                '<div class="toast-body">' + message + '</div>' +
                '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>' +
                '</div></div>';
            if ($('#ajaxToast').length) $('#ajaxToast').remove();
            $('body').append(toastHtml);
            var toastEl = document.getElementById('ajaxToast');
            var toast = new bootstrap.Toast(toastEl, { delay: 3000 });
            toast.show();
            setTimeout(function () { if ($('#ajaxToast').length) $('#ajaxToast').remove(); }, 3500);
        }
    </script>
