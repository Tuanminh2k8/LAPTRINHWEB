@if (totalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Orders", new { status = selectedStatus, search = search, sort = sortOrder, page = pageNumber - 1 })">
                    <i class="fa-solid fa-chevron-left"></i>
                </a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == pageNumber ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Orders", new { status = selectedStatus, search = search, sort = sortOrder, page = i })">@i</a>
                </li>
            }
            <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Orders", new { status = selectedStatus, search = search, sort = sortOrder, page = pageNumber + 1 })">
                    <i class="fa-solid fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}

