@model IEnumerable<Source.Models.Order>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Đơn Hàng";
    var selectedStatus = ViewBag.SelectedStatus as string;
    var search = ViewBag.Search as string;
    var sortOrder = ViewBag.SortOrder as string;
    var pageNumber = ViewBag.PageNumber as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var statusCounts = ViewBag.StatusCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
    var allStatuses = new[] { "Pending", "Preparing", "Shipping", "Delivered", "Cancelled", "Refunded" };
    string GetStatusBadgeClass(string s) => s switch
    {
        "Pending" => "bg-warning text-dark",
        "Preparing" => "bg-info text-dark",
        "Shipping" => "bg-primary",
        "Delivered" => "bg-success",
        "Cancelled" => "bg-danger",
        "Refunded" => "bg-secondary",
        _ => "bg-secondary"
    };
    string GetStatusLabel(string s) => s switch
    {
        "Pending" => "Chờ xác nhận",
        "Preparing" => "Đang chuẩn bị",
        "Shipping" => "Đang giao",
        "Delivered" => "Đã giao",
        "Cancelled" => "Đã hủy",
        "Refunded" => "Hoàn tiền",
        _ => s
    };
}

