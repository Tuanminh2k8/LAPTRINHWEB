@model IEnumerable<Source.Models.Order>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Đơn Hàng";
    var selectedStatus = ViewBag.SelectedStatus as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Quản Lý Đơn Hàng</h3>
        <p class="text-muted small mb-0">Xem và cập nhật trạng thái các đơn hàng</p>
    </div>
</div>

@Html.AntiForgeryToken()

<div class="mb-4 d-flex flex-wrap gap-2">
    <a asp-action="Orders" class="btn @(string.IsNullOrEmpty(selectedStatus) ? "btn-primary-custom" : "btn-secondary-custom") btn-custom rounded-pill px-4 py-2" style="font-size:.85rem;">
        Tất cả
    </a>
    <a asp-action="Orders" asp-route-status="Chưa giao" class="btn @(selectedStatus == "Chưa giao" ? "btn-primary-custom" : "btn-secondary-custom") btn-custom rounded-pill px-4 py-2" style="font-size:.85rem;">
        Chưa giao
    </a>
    <a asp-action="Orders" asp-route-status="Đang giao" class="btn @(selectedStatus == "Đang giao" ? "btn-primary-custom" : "btn-secondary-custom") btn-custom rounded-pill px-4 py-2" style="font-size:.85rem;">
        Đang giao
    </a>
    <a asp-action="Orders" asp-route-status="Đã giao" class="btn @(selectedStatus == "Đã giao" ? "btn-primary-custom" : "btn-secondary-custom") btn-custom rounded-pill px-4 py-2" style="font-size:.85rem;">
        Đã giao
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="bg-dark text-white">
                <tr>
                    <th>Mã Đơn</th>
                    <th>Người Nhận</th>
                    <th>Số Điện Thoại</th>
                    <th>Địa Chỉ</th>
                    <th>Ngày Đặt</th>
                    <th>Tổng Tiền</th>
                    <th>Trạng Thái</th>
                    <th class="text-center">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">Không tìm thấy đơn hàng nào.</td>
                    </tr>
                }
                else
                {
                    @foreach (var order in Model)
                    {
                        <tr id="order-row-@order.Id">
                            <td class="fw-bold text-muted">#@order.Id</td>
                            <td class="fw-bold text-dark">@order.ReceiverName</td>
                            <td class="small">@order.ReceiverPhone</td>
                            <td class="small text-truncate" style="max-width: 200px;">@order.ReceiverAddress</td>
                            <td class="small">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold text-danger">@order.TotalAmount.ToString("N0") ₫</td>
                            <td>
                                <select class="form-select form-select-sm status-select rounded-pill" data-id="@order.Id" style="width: 130px;">
                                    <option value="Chưa giao" selected="@(order.Status == "Chưa giao")">Chưa giao</option>
                                    <option value="Đang giao" selected="@(order.Status == "Đang giao")">Đang giao</option>
                                    <option value="Đã giao" selected="@(order.Status == "Đã giao")">Đã giao</option>
                                </select>
                            </td>
                            <td class="text-center">
                                <a asp-action="OrderDetail" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary border-0 rounded-circle p-2" title="Chi tiết">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" />
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.status-select').change(function () {
                var orderId = $(this).data('id');
                var newStatus = $(this).val();
                $.ajax({
                    url: '@Url.Action("UpdateOrderStatus", "Admin")',
                    type: 'POST',
                    data: {
                        id: orderId,
                        status: newStatus,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (res) {
                        if (res.success) {
                            showToast('Đã cập nhật đơn hàng #' + orderId + ' thành: ' + newStatus, 'success');
                        }
                    },
                    error: function () {
                        showToast('Cập nhật thất bại. Vui lòng thử lại.', 'danger');
                    }
                });
            });
        });
    </script>
}
