@model IEnumerable<Source.Models.Order>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Bảng Điều Khiển";
}

<div class="mb-4">
    <h3 class="fw-bold text-dark mb-1">Bảng Điều Khiển</h3>
    <p class="text-muted small">Tổng quan tình hình kinh doanh của PolyFood Store</p>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-6 col-xl-3">
        <div class="admin-card-stat bg-orders">
            <div class="card-body">
                <h6 class="text-white-50 text-uppercase fw-bold mb-2">Tổng Đơn Hàng</h6>
                <h2 class="fw-bold mb-0">@ViewBag.TotalOrders</h2>
                <i class="fa-solid fa-receipt admin-stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="admin-card-stat bg-pending">
            <div class="card-body">
                <h6 class="text-white-50 text-uppercase fw-bold mb-2">Đơn Chưa Giao</h6>
                <h2 class="fw-bold mb-0">@ViewBag.PendingOrders</h2>
                <i class="fa-solid fa-clock admin-stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="admin-card-stat bg-revenue">
            <div class="card-body">
                <h6 class="text-white-50 text-uppercase fw-bold mb-2">Doanh Thu Đã Giao</h6>
                <h2 class="fw-bold mb-0">@(((decimal)ViewBag.TotalRevenue).ToString("N0")) ₫</h2>
                <i class="fa-solid fa-sack-dollar admin-stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="admin-card-stat bg-users">
            <div class="card-body">
                <h6 class="text-white-50 text-uppercase fw-bold mb-2">Người Dùng</h6>
                <h2 class="fw-bold mb-0">@ViewBag.TotalUsers</h2>
                <i class="fa-solid fa-users admin-stat-icon"></i>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <div class="card-header bg-white p-4 d-flex justify-content-between align-items-center border-0">
        <h5 class="fw-bold text-dark mb-0">Đơn Hàng Mới Nhất</h5>
        <a asp-action="Orders" class="btn btn-secondary-custom btn-custom py-2 px-3" style="font-size:.82rem;">Xem tất cả</a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="bg-light">
                <tr class="text-muted small">
                    <th>Mã Đơn</th>
                    <th>Khách Hàng</th>
                    <th>Ngày Đặt</th>
                    <th>Tổng Tiền</th>
                    <th>Trạng Thái</th>
                    <th class="text-center">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Chưa có đơn hàng nào.</td>
                    </tr>
                }
                else
                {
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">#@order.Id</td>
                            <td>
                                <div class="fw-bold">@order.ReceiverName</div>
                                <div class="small text-muted">@order.ReceiverPhone</div>
                            </td>
                            <td class="small">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold text-danger">@order.TotalAmount.ToString("N0") ₫</td>
                            <td>
                                @if (order.Status == "Chưa giao")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill">Chưa giao</span>
                                }
                                else if (order.Status == "Đang giao")
                                {
                                    <span class="badge bg-info text-dark px-3 py-1 rounded-pill">Đang giao</span>
                                }
                                else
                                {
                                    <span class="badge bg-success px-3 py-1 rounded-pill">Đã giao</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="OrderDetail" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary border-0 rounded-circle p-2" title="Chi tiết">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
