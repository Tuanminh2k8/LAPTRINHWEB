@model Source.Models.User
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chỉnh Sửa Người Dùng #" + Model.Id;
}

<div class="mb-4">
    <h3 class="fw-bold text-dark mb-1"><i class="fa-solid fa-user-pen text-danger me-2"></i>Chỉnh Sửa Người Dùng #@Model.Id</h3>
    <a asp-action="Users" class="text-muted small text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i> Trở về danh sách</a>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5">
    <form asp-action="UserEdit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 py-2 small mb-3"></div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Username" class="form-label fw-bold small text-muted"></label>
                <input asp-for="Username" class="form-control form-control-custom" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold small text-muted">Mật khẩu mới (Bỏ trống nếu không đổi)</label>
                <input type="password" name="newPassword" class="form-control form-control-custom" placeholder="Nhập mật khẩu mới..." />
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label fw-bold small text-muted"></label>
                <input asp-for="FullName" class="form-control form-control-custom" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label fw-bold small text-muted"></label>
                <input asp-for="Email" type="email" class="form-control form-control-custom" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="PhoneNumber" class="form-label fw-bold small text-muted"></label>
                <input asp-for="PhoneNumber" class="form-control form-control-custom" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Role" class="form-label fw-bold small text-muted"></label>
                <select asp-for="Role" class="form-select form-control-custom">
                    <option value="Customer">Customer (Khách hàng)</option>
                    <option value="Admin">Admin (Quản trị viên)</option>
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="Address" class="form-label fw-bold small text-muted"></label>
            <textarea asp-for="Address" class="form-control form-control-custom" rows="3"></textarea>
            <span asp-validation-for="Address" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <a asp-action="Users" class="btn btn-secondary-custom btn-custom">Hủy bỏ</a>
            <button type="submit" class="btn btn-danger btn-custom rounded-pill px-4">Lưu Thay Đổi</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
