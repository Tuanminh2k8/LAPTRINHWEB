@model Source.Models.FastFood
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thêm Món Ăn Mới";
    var categories = ViewBag.Categories as IEnumerable<Source.Models.Category> ?? new List<Source.Models.Category>();
}

<div class="mb-4">
    <h3 class="fw-bold text-dark mb-1">Thêm Món Ăn Mới</h3>
    <a asp-action="Foods" class="text-muted small text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i> Trở về danh sách</a>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5">
    <form asp-action="FoodCreate" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 py-2 small mb-3"></div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label fw-bold small text-muted"></label>
                <input asp-for="Name" class="form-control form-control-custom" placeholder="Nhập tên món ăn..." />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Price" class="form-label fw-bold small text-muted"></label>
                <input asp-for="Price" type="number" step="1000" class="form-control form-control-custom" placeholder="Nhập giá tiền (₫)..." />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label fw-bold small text-muted"></label>
                <select asp-for="CategoryId" class="form-select form-control-custom">
                    <option value="">-- Chọn Chủng Loại --</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Theme" class="form-label fw-bold small text-muted"></label>
                <input asp-for="Theme" class="form-control form-control-custom" placeholder="Ví dụ: Gia đình, Ăn vặt, Tiệc tùng..." />
                <span asp-validation-for="Theme" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold small text-muted">Hình ảnh món ăn</label>
            <input type="file" name="imageFile" class="form-control form-control-custom" accept="image/*" />
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="form-label fw-bold small text-muted"></label>
            <textarea asp-for="Description" class="form-control form-control-custom" rows="3" placeholder="Nhập mô tả chi tiết..."></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <a asp-action="Foods" class="btn btn-secondary-custom btn-custom">Hủy bỏ</a>
            <button type="submit" class="btn btn-primary-custom btn-custom rounded-pill px-4">Lưu Món Ăn</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
