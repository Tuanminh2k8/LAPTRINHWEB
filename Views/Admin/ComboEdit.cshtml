@model Source.Models.Combo
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chỉnh Sửa Combo #" + Model.Id;
    var foods = ViewBag.Foods as IEnumerable<Source.Models.FastFood> ?? new List<Source.Models.FastFood>();
    var selectedFoodIds = ViewBag.SelectedFoodIds as int[] ?? Array.Empty<int>();
    var foodQuantities = ViewBag.FoodQuantities as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="mb-4">
    <h3 class="fw-bold text-dark mb-1"><i class="fa-solid fa-pen-to-square text-danger me-2"></i>Chỉnh Sửa Gói Combo #@Model.Id</h3>
    <a asp-action="Combos" class="text-muted small text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i> Trở về danh sách Combo</a>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5">
    <form asp-action="ComboEdit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageUrl" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 py-2 small mb-3"></div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label fw-bold small text-muted"></label>
                <input asp-for="Name" class="form-control form-control-custom" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Price" class="form-label fw-bold small text-muted"></label>
                <input asp-for="Price" type="number" step="1000" class="form-control form-control-custom" />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mb-3 align-items-center">
            <div class="col-md-3 text-center">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="rounded-3 shadow-sm img-fluid" style="max-height: 100px;">
            </div>
            <div class="col-md-9">
                <label class="form-label fw-bold small text-muted">Thay đổi ảnh (Bỏ trống nếu giữ nguyên)</label>
                <input type="file" name="imageFile" class="form-control form-control-custom" accept="image/*" />
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="form-label fw-bold small text-muted"></label>
            <textarea asp-for="Description" class="form-control form-control-custom" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="mb-4 p-3 bg-light rounded-3 border">
            <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-check-double text-danger me-2"></i>Chọn các món lẻ thuộc Combo này:</h6>
            <div class="row g-3">
                @foreach (var food in foods)
                {
                    bool isSelected = selectedFoodIds.Contains(food.Id);
                    int qty = foodQuantities.ContainsKey(food.Id) ? foodQuantities[food.Id] : 1;

                    <div class="col-md-6">
                        <div class="d-flex align-items-center justify-content-between p-2 border bg-white rounded-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="selectedFoods" value="@food.Id" id="food_@food.Id" @(isSelected ? "checked" : "")>
                                <label class="form-check-label fw-600 small" for="food_@food.Id">
                                    @food.Name (@food.Price.ToString("N0") ₫)
                                </label>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <span class="small text-muted">SL:</span>
                                <input type="number" name="foodQuantities" value="@qty" min="1" max="10" class="form-control form-control-sm text-center" style="width: 60px;">
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <a asp-action="Combos" class="btn btn-secondary-custom btn-custom">Hủy bỏ</a>
            <button type="submit" class="btn btn-danger btn-custom rounded-pill px-4">Lưu Thay Đổi</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
