@model IEnumerable<Source.Models.User>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Người Dùng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Quản Lý Người Dùng</h3>
        <p class="text-muted small mb-0">Quản lý danh sách tài khoản</p>
    </div>
    <a asp-action="UserCreate" class="btn btn-primary-custom btn-custom rounded-pill px-4 py-2">
        <i class="fa-solid fa-user-plus me-2"></i> Thêm Người Dùng
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="bg-dark text-white">
                <tr>
                    <th>ID</th>
                    <th>Tên Đăng Nhập</th>
                    <th>Họ và Tên</th>
                    <th>Email</th>
                    <th>Số Điện Thoại</th>
                    <th>Vai Trò</th>
                    <th class="text-center">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-bold text-muted">#@user.Id</td>
                        <td class="fw-bold text-dark">@user.Username</td>
                        <td>@user.FullName</td>
                        <td class="small text-muted">@user.Email</td>
                        <td class="small">@user.PhoneNumber</td>
                        <td>
                            @if (user.Role == "Admin")
                            {
                                <span class="badge bg-danger px-3 py-1 rounded-pill"><i class="fa-solid fa-user-shield me-1"></i>Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-3 py-1 rounded-pill">Customer</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="UserEdit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary border-0 rounded-circle p-2 me-1" title="Sửa">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <form asp-action="UserDelete" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa người dùng này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-2" title="Xóa">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" />
</div>
