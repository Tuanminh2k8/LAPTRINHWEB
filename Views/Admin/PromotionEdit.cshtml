@model PromoCode
@{
    ViewData["Title"] = "Sửa mã giảm giá";
}

<div class="container-fluid py-4" style="max-width:960px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="fw-bold mb-0" style="font-family:'Plus Jakarta Sans',sans-serif;">
            <i class="fa-solid fa-pen text-danger me-2"></i> Sửa mã: <span class="font-monospace">@Model.Code</span>
        </h2>
        <a class="btn btn-outline-dark rounded-3" asp-action="Promotions">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <form method="post" asp-action="PromotionEdit" asp-route-id="@Model.Id">
        <div class="card rounded-4 border-0 shadow-sm mb-3">
            <div class="card-header bg-dark text-white fw-semibold">Thông tin cơ bản</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Mã giảm giá <span class="text-danger">*</span></label>
                        <input asp-for="Code" class="form-control rounded-3 font-monospace" />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tên chương trình</label>
                        <input asp-for="Name" class="form-control rounded-3" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Mô tả</label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="2"></textarea>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Loại giảm</label>
                        <select asp-for="DiscountType" class="form-select rounded-3">
                            <option value="Percent">Theo phần trăm (%)</option>
                            <option value="Amount">Theo số tiền (₫)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Giá trị giảm</label>
                        <input asp-for="DiscountValue" type="number" step="0.01" min="0" class="form-control rounded-3" />
                        <span asp-validation-for="DiscountValue" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Giảm tối đa (₫)</label>
                        <input asp-for="MaxDiscountAmount" type="number" step="0.01" min="0" class="form-control rounded-3" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Đơn tối thiểu (₫)</label>
                        <input asp-for="MinOrderAmount" type="number" step="0.01" min="0" class="form-control rounded-3" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tổng lượt dùng</label>
                        <input asp-for="MaxUsage" type="number" min="0" class="form-control rounded-3" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Giới hạn / người dùng</label>
                        <input asp-for="MaxUsagePerUser" type="number" min="0" class="form-control rounded-3" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card rounded-4 border-0 shadow-sm mb-3">
            <div class="card-header bg-dark text-white fw-semibold">Thời gian &amp; hiển thị</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Bắt đầu</label>
                        <input asp-for="StartDate" type="datetime-local" class="form-control rounded-3"
                               value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Kết thúc</label>
                        <input asp-for="EndDate" type="datetime-local" class="form-control rounded-3"
                               value="@Model.EndDate?.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Độ ưu tiên</label>
                        <input asp-for="Priority" type="number" class="form-control rounded-3" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Ảnh / Banner URL</label>
                        <input asp-for="ImageUrl" class="form-control rounded-3" />
                        <input asp-for="BannerUrl" class="form-control rounded-3 mt-2" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Chủ đề trang trí trang chủ</label>
                        <select asp-for="Theme" class="form-select rounded-3">
                            <option value="">Không (mặc định)</option>
                            <option value="Halloween">Halloween 🎃</option>
                            <option value="Winter">Mùa đông / Giáng sinh ❄️</option>
                            <option value="NewYear">Năm mới 🎆</option>
                            <option value="Valentine">Valentine 💝</option>
                            <option value="Summer">Hè ☀️</option>
                        </select>
                        <div class="form-text small">Khi có mã chủ đề này hiển thị, trang chủ tự động trang trí theo.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card rounded-4 border-0 shadow-sm mb-3">
            <div class="card-header bg-dark text-white fw-semibold">Tùy chọn phát hành</div>
            <div class="card-body">
                <div class="form-check form-switch mb-2">
                    <input asp-for="IsPublished" class="form-check-input" type="checkbox" />
                    <label asp-for="IsPublished" class="form-check-label">Đã phát hành (hiển thị công khai)</label>
                </div>
                <div class="form-check form-switch mb-2">
                    <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                    <label asp-for="IsFeatured" class="form-check-label">Nổi bật trên trang chủ</label>
                </div>
                <div class="form-check form-switch mb-2">
                    <input asp-for="IsEarlyPublished" class="form-check-input" type="checkbox" />
                    <label asp-for="IsEarlyPublished" class="form-check-label">Đẩy lên trước (cho phép hiển thị &amp; dùng sớm)</label>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="IsVisibleEarly" class="form-check-input" type="checkbox" />
                    <label asp-for="IsVisibleEarly" class="form-check-label">Hiển thị sớm (trước giờ bắt đầu)</label>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary-custom rounded-3 px-4">
                <i class="fa-solid fa-save me-1"></i> Cập nhật
            </button>
            <a class="btn btn-outline-secondary rounded-3" asp-action="Promotions">Hủy</a>
        </div>
    </form>
</div>
