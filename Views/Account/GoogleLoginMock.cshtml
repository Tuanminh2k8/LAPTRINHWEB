@{
    ViewData["Title"] = "Giả Lập Đăng Nhập Google";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5 text-center bg-white">
                    <svg class="mb-3" width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Google">
                        <path d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z" fill="#FFC107"/>
                        <path d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z" fill="#FF3D00"/>
                        <path d="M24 44c5.166 0 10.144-2.003 13.864-5.464l-6.36-5.38C29.806 35.722 27.099 36.99 24 36.99c-5.322 0-9.817-3.323-11.51-7.978l-6.655 5.128C8.954 39.66 15.588 44 24 44z" fill="#4CAF50"/>
                        <path d="M43.611 20.083H42V20H24v8h11.303c-.792 2.237-2.231 4.166-4.087 5.571l.003-.002 6.36 5.38C36.015 36.514 44 30.697 44 24c0-1.341-.138-2.65-.389-3.917z" fill="#1976D2"/>
                    </svg>
                    <h4 class="fw-bold text-dark mb-2">Đăng Nhập Bằng Google</h4>
                    <p class="small text-muted mb-4">Giả lập SSO Google OAuth2 cho dự án môn học</p>

                    <form asp-controller="Account" asp-action="GoogleLoginMockSubmit" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3 text-start">
                            <label class="form-label small fw-bold text-muted">Email Google</label>
                            <input type="email" name="email" class="form-control form-control-custom" value="google.user@gmail.com" required />
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label small fw-bold text-muted">Họ và Tên Google</label>
                            <input type="text" name="name" class="form-control form-control-custom" value="Google User Demo" required />
                        </div>

                        <input type="hidden" name="subId" value="google_sub_123456789" />

                        <button type="submit" class="btn btn-outline-dark w-100 py-3 rounded-pill fw-bold mb-3 shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <i class="fa-brands fa-google text-danger fs-5"></i> Tiếp tục với Google Demo
                        </button>

                        <a asp-action="Login" class="small text-muted text-decoration-none">Hủy và quay lại trang Đăng nhập</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
