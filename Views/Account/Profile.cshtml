@model Source.Models.User
@{
    ViewData["Title"] = "Hồ Sơ Cá Nhân";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="fw-bold text-white mb-1"><i class="fa-solid fa-id-badge text-danger me-2"></i>Hồ Sơ Thành Viên</h4>
                        <p class="small text-white-50 mb-0">Quản lý và cập nhật thông tin tài khoản cá nhân của bạn</p>
                    </div>
                    <span class="badge bg-danger rounded-pill px-3 py-2">@Model.Role</span>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-controller="Account" asp-action="Profile" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 py-2 small mb-3"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Tên đăng nhập (Username)</label>
                                <input type="text" class="form-control bg-light" value="@Model.Username" readonly disabled />
                                <span class="form-text small text-muted">Tên đăng nhập không thể chỉnh sửa.</span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label fw-bold small text-muted"></label>
                                <input asp-for="FullName" class="form-control form-control-custom" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold small text-muted"></label>
                                <input asp-for="Email" class="form-control form-control-custom" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-bold small text-muted"></label>
                                <input asp-for="PhoneNumber" class="form-control form-control-custom" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Address" class="form-label fw-bold small text-muted"></label>
                            <textarea asp-for="Address" class="form-control form-control-custom" rows="3"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-warning rounded-pill px-3">
                                <i class="fa-solid fa-key me-1"></i> Đổi mật khẩu
                            </a>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow-sm">
                                <i class="fa-solid fa-floppy-disk me-2"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
