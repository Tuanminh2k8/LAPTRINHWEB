@model Source.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng Ký";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="text-center pt-5 px-4">
                    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center" style="width:64px;height:64px;border-radius:16px;background:var(--gradient-primary);">
                        <i class="fa-solid fa-user-plus fa-2x text-white"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Tạo Tài Khoản</h3>
                    <p class="text-muted small mb-0">Đăng ký thành viên PolyFood để nhận ưu đãi</p>
                </div>

                <div class="p-4 p-md-5">
                    <form asp-controller="Account" asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 py-2 small mb-3"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Username" class="form-label small fw-bold text-muted"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-at"></i></span>
                                    <input asp-for="Username" class="form-control border-start-0 bg-light" placeholder="Username..." />
                                </div>
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label small fw-bold text-muted"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-id-card"></i></span>
                                    <input asp-for="FullName" class="form-control border-start-0 bg-light" placeholder="Họ và tên..." />
                                </div>
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label small fw-bold text-muted"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-envelope"></i></span>
                                    <input asp-for="Email" class="form-control border-start-0 bg-light" placeholder="example@email.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label small fw-bold text-muted"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-phone"></i></span>
                                    <input asp-for="PhoneNumber" class="form-control border-start-0 bg-light" placeholder="09xxxx..." />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label small fw-bold text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-location-dot"></i></span>
                                <input asp-for="Address" class="form-control border-start-0 bg-light" placeholder="Địa chỉ giao hàng..." />
                            </div>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label small fw-bold text-muted"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-lock"></i></span>
                                    <input asp-for="Password" class="form-control border-start-0 bg-light" placeholder="Tối thiểu 6 ký tự..." />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label small fw-bold text-muted"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-shield"></i></span>
                                    <input asp-for="ConfirmPassword" class="form-control border-start-0 bg-light" placeholder="Nhập lại mật khẩu..." />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary-custom btn-custom w-100 py-3 rounded-pill shadow-sm mb-3">
                            <i class="fa-solid fa-user-check me-2"></i> Hoàn Tất Đăng Ký
                        </button>

                        <div class="text-center">
                            <p class="small text-muted mb-0">Đã có tài khoản?
                                <a asp-action="Login" class="text-danger fw-bold text-decoration-none">Đăng nhập</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
