@model Source.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi Mật Khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="fw-bold text-white mb-1"><i class="fa-solid fa-key text-warning me-2"></i>Đổi Mật Khẩu</h4>
                        <p class="small text-white-50 mb-0">Cập nhật mật khẩu mới cho tài khoản của bạn</p>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-controller="Account" asp-action="ChangePassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 py-2 small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-bold small text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-lock"></i></span>
                                <input asp-for="CurrentPassword" class="form-control bg-light border-start-0 py-2" placeholder="Nhập mật khẩu hiện tại..." />
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger small ms-1"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-bold small text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-key"></i></span>
                                <input asp-for="NewPassword" class="form-control bg-light border-start-0 py-2" placeholder="Nhập mật khẩu mới (ít nhất 6 ký tự)..." />
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small ms-1"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmNewPassword" class="form-label fw-bold small text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-shield-halved"></i></span>
                                <input asp-for="ConfirmNewPassword" class="form-control bg-light border-start-0 py-2" placeholder="Nhập lại mật khẩu mới..." />
                            </div>
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small ms-1"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại hồ sơ
                            </a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow-sm">
                                <i class="fa-solid fa-check me-2"></i> Cập nhật mật khẩu
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
