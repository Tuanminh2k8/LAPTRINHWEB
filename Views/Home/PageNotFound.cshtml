@{
    ViewData["Title"] = "Không Tìm Thấy Trang";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center py-5">
            <div class="mb-4">
                <i class="fa-solid fa-map-signs text-muted" style="font-size: 5rem;"></i>
            </div>
            <h1 class="fw-bold text-dark mb-3">404 - Trang Không Tồn Tại</h1>
            <p class="text-muted fs-5 mb-4">
                Trang bạn đang tìm kiếm không tồn tại hoặc đã bị di chuyển.
                Vui lòng kiểm tra lại đường dẫn hoặc quay về trang chủ.
            </p>

            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom btn-custom px-4">
                    <i class="fa-solid fa-house me-2"></i>Về trang chủ
                </a>
                <button onclick="history.back()" class="btn btn-secondary-custom btn-custom px-4">
                    <i class="fa-solid fa-arrow-left me-2"></i>Quay lại
                </button>
            </div>
        </div>
    </div>
</div>
