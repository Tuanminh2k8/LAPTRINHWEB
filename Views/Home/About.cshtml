@{
    ViewData["Title"] = "Về Chúng Tôi";
}

<section class="about-hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <h1 class="about-hero-title">Câu Chuyện Về <span>PolyFood</span></h1>
                <p class="about-hero-desc">Thành lập từ năm 2020, PolyFood tự hào là hệ thống đặt thức ăn nhanh hàng đầu tại Đồng Nai. Chúng tôi cam kết mang đến những bữa ăn nóng hổi, thơm ngon và vệ sinh với dịch vụ giao hàng siêu tốc trong 30 phút.</p>
                <div class="d-flex gap-3 flex-wrap">
                    <div class="about-stat">
                        <span class="about-stat-number">50K+</span>
                        <span class="about-stat-label">Khách hàng</span>
                    </div>
                    <div class="about-stat">
                        <span class="about-stat-number">100+</span>
                        <span class="about-stat-label">Món ăn</span>
                    </div>
                    <div class="about-stat">
                        <span class="about-stat-number">30 phút</span>
                        <span class="about-stat-label">Giao hàng</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="about-hero-img">
                    <img src="/images/others/restaurant-bg.jpg" alt="PolyFood Restaurant" loading="lazy">
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container mb-5">
    <div class="about-features-bar">
        <div class="about-feature-item">
            <div class="about-feature-icon"><i class="fa-solid fa-truck-fast"></i></div>
            <h6>Giao hàng siêu tốc</h6>
            <p>Cam kết giao hàng trong vòng 30 phút kể từ khi đặt hàng. Nhanh chóng - Nóng hổi.</p>
        </div>
        <div class="about-feature-item">
            <div class="about-feature-icon"><i class="fa-solid fa-leaf"></i></div>
            <h6>Nguyên liệu sạch</h6>
            <p>100% nguyên liệu có nguồn gốc rõ ràng, đạt chuẩn vệ sinh an toàn thực phẩm.</p>
        </div>
        <div class="about-feature-item">
            <div class="about-feature-icon"><i class="fa-solid fa-headset"></i></div>
            <h6>Hỗ trợ 24/7</h6>
            <p>Đội ngũ chăm sóc khách hàng luôn sẵn sàng hỗ trợ bạn mọi lúc, mọi nơi.</p>
        </div>
        <div class="about-feature-item">
            <div class="about-feature-icon"><i class="fa-solid fa-wallet"></i></div>
            <h6>Thanh toán linh hoạt</h6>
            <p>Chấp nhận tiền mặt, chuyển khoản, thẻ tín dụng và ví điện tử.</p>
        </div>
    </div>
</section>

<section class="container mb-5">
    <div class="text-center mb-5">
        <h2 class="fw-800 mb-3">Đội Ngũ Của Chúng Tôi</h2>
        <p class="text-muted" style="max-width:600px;margin:0 auto;">Những con người tận tâm, đam mê ẩm thực và luôn nỗ lực mang đến trải nghiệm tốt nhất cho khách hàng.</p>
    </div>
    <div class="row g-4 justify-content-center">
        <div class="col-md-4 col-lg-3">
            <div class="about-team-card">
                <div class="about-team-avatar">
                    <img src="/images/avatars/user1.jpg" alt="Tuấn Minh" loading="lazy">
                </div>
                <h5>Tuấn Minh</h5>
                <span class="about-team-role">Founder & CEO</span>
            </div>
        </div>
        <div class="col-md-4 col-lg-3">
            <div class="about-team-card">
                <div class="about-team-avatar">
                    <img src="/images/avatars/user2.jpg" alt="Kiệt Boggi" loading="lazy">
                </div>
                <h5>Kiệt Boggi</h5>
                <span class="about-team-role">Head Chef</span>
            </div>
        </div>
        <div class="col-md-4 col-lg-3">
            <div class="about-team-card">
                <div class="about-team-avatar">
                    <img src="/images/avatars/user3.jpg" alt="Hồng Sơn" loading="lazy">
                </div>
                <h5>Anh Tiến</h5>
                <span class="about-team-role">Operations Manager</span>
            </div>
        </div>
    </div>
</section>
