@{
    ViewData["Title"] = "Trang không tìm thấy";
    var statusCode = ViewBag.StatusCode as int? ?? 404;
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white p-5">
                <div class="mb-4">
                    <i class="fa-solid fa-map-location-dot text-danger fa-4x mb-3"></i>
                    <h1 class="fw-800 text-dark display-3">@statusCode</h1>
                    <h3 class="fw-bold text-dark mb-3">Oops! Trang không tìm thấy</h3>
                    <p class="text-muted mb-4">Trang bạn đang tìm kiếm có thể đã bị xóa, đổi tên hoặc tạm thời không khả dụng.</p>
                </div>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-danger btn-custom rounded-pill px-4 py-3 shadow-sm">
                        <i class="fa-solid fa-house me-2"></i> Về trang chủ
                    </a>
                    <button onclick="history.back()" class="btn btn-outline-secondary rounded-pill px-4 py-3">
                        <i class="fa-solid fa-arrow-left me-2"></i> Quay lại
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
