@model IEnumerable<Source.Models.FastFood>
@{
    ViewData["Title"] = "Trang Chủ";
    var categories = ViewBag.Categories as IEnumerable<Source.Models.Category> ?? new List<Source.Models.Category>();
    var combos = ViewBag.Combos as IEnumerable<Source.Models.Combo> ?? new List<Source.Models.Combo>();
    var selectedCategory = ViewBag.SelectedCategory as int?;
    var searchName = ViewBag.SearchName as string;
    var sortOrder = ViewBag.SortOrder as string;
    var pageNumber = ViewBag.PageNumber as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;

    var categoryIcons = new Dictionary<string, string>
    {
        { "Tat ca", "fa-border-all" },
        { "Burger", "fa-burger" },
        { "Pizza", "fa-pizza-slice" },
        { "Chicken", "fa-drumstick-bite" },
        { "Ga", "fa-drumstick-bite" },
        { "Do Uong", "fa-glass-water" },
        { "Drink", "fa-glass-water" },
        { "Mon Kem", "fa-french-fries" },
        { "Side", "fa-french-fries" },
        { "Salad", "fa-leaf" },
        { "Trang mieng", "fa-cake-candles" },
        { "Dessert", "fa-cake-candles" },
        { "Combo", "fa-box" },
        { "Pasta", "fa-utensils" }
    };

    var comboUnsplash = new List<string>
    {
        "https://images.unsplash.com/photo-1513104890138-7c749659a591?w=600",
        "https://images.unsplash.com/photo-1544025162-d76694265947?w=600",
        "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=600"
    };
}

<!-- Auto-Slider Banner - Shopee Style -->
<section class="polyfood-hero-banner">
    <div class="container">
        <div class="row g-0">
            <div class="col-12">
                <div id="homepageSlider" class="carousel-slider">
                    <div class="slider-item active">
                        <div class="slider-img">
                            <img src="https://images.unsplash.com/photo-1513104890138-7c749659a591?w=1200&q=80&auto=format&fit=crop" alt="PolyFood Promotion">
                        </div>
                        <div class="slider-caption">
                            <h4>Giảm 30% món chính</h4>
                            <p>Món nóng hổi cho cả nhà</p>
                        </div>
                    </div>
                    <div class="slider-item">
                        <div class="slider-img">
                            <img src="https://images.unsplash.com/photo-1544025162-d76694265947?w=1200&q=80&auto=format&fit=crop" alt="PolyFood Promotion">
                        </div>
                        <div class="slider-caption">
                            <h4>Combo gia đình giảm 20%</h4>
                            <p>Đồ uống + món chính</p>
                        </div>
                    </div>
                    <div class="slider-item">
                        <div class="slider-img">
                            <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=1200&q=80&auto=format&fit=crop" alt="PolyFood Promotion">
                        </div>
                        <div class="slider-caption">
                            <h4>Shipper tặng kèm món ngon</h4>
                            <p>Mỗi đơn nhận 1 đồ kèm</p>
                        </div>
                    </div>
                </div>
                <button class="slider-control prev" aria-label="Trang trước">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <button class="slider-control next" aria-label="Trang sau">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
                <div class="slider-dots"></div>
            </div>
        </div>
    </div>
</section>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <form asp-controller="Home" asp-action="Index" method="get">
                <div class="search-pill-bar">
                    <i class="fa-solid fa-magnifying-glass search-pill-icon"></i>
                    <input type="text" class="search-pill-input" name="searchName" value="@searchName" placeholder="Tìm kiếm món ăn yêu thích..." aria-label="Tìm kiếm">
                    @if (selectedCategory.HasValue)
                    {
                        <input type="hidden" name="categoryId" value="@selectedCategory.Value">
                    }
                    <button type="submit" class="search-pill-btn">Tìm kiếm</button>
                </div>
            </form>

            <div class="text-center mt-3">
                <button class="btn btn-ghost btn-sm rounded-pill px-3" type="button" data-bs-toggle="collapse" data-bs-target="#advancedSearchPanel" aria-expanded="false" aria-controls="advancedSearchPanel">
                    <i class="fa-solid fa-sliders me-1"></i> Tìm kiếm nâng cao
                </button>
            </div>

            <div class="collapse mt-4" id="advancedSearchPanel">
                <div class="glass-panel">
                    <h5 class="fw-bold mb-3 text-danger"><i class="fa-solid fa-search-plus me-2"></i>Bộ lọc tìm kiếm nâng cao</h5>
                    <form id="advSearchForm">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Tên món ăn</label>
                                <input type="text" name="name" class="form-control form-control-custom" placeholder="Ví dụ: Burger, Pizza...">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Chủng loại</label>
                                <select name="categoryId" class="form-select form-control-custom">
                                    <option value="">Tất cả chủng loại</option>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <label class="form-label">Giá tối thiểu (₫)</label>
                                <input type="number" name="minPrice" class="form-control form-control-custom" placeholder="0">
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <label class="form-label">Giá tối đa (₫)</label>
                                <input type="number" name="maxPrice" class="form-control form-control-custom" placeholder="500000">
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <label class="form-label">Chủ đề</label>
                                <input type="text" name="theme" class="form-control form-control-custom" placeholder="Gia đình, Ăn vặt...">
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <label class="form-label">Thông tin món ăn</label>
                                <input type="text" name="description" class="form-control form-control-custom" placeholder="Từ khóa trong mô tả...">
                            </div>
                            <div class="col-12 d-flex justify-content-end gap-2 mt-3">
                                <button type="button" id="btnResetAdv" class="btn btn-secondary-custom btn-custom py-2">Đặt lại</button>
                                <button type="button" id="btnSearchAdv" class="btn btn-primary-custom btn-custom py-2">Tìm kiếm ngay</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="polyfood-category-section">
    <div class="container">
        <div class="polyfood-section-header">
            <div class="polyfood-section-icon">
                <i class="fa-solid fa-list-ul"></i>
            </div>
            <h3 class="polyfood-section-title">Danh mục món ăn</h3>
        </div>
        <div class="polyfood-category-grid">
            <a asp-action="Index" asp-route-searchName="@searchName" class="polyfood-category-card @(selectedCategory == null ? "active" : "")">
                <div class="polyfood-category-icon">
                    <i class="fa-solid fa-border-all"></i>
                </div>
                <span>Tất cả</span>
            </a>
            @foreach (var cat in categories)
            {
                <a asp-action="Index" asp-route-categoryId="@cat.Id" asp-route-searchName="@searchName" class="polyfood-category-card @(selectedCategory == cat.Id ? "active" : "")">
                    <div class="polyfood-category-icon">
                        @{
                            var iconKey = categoryIcons.Keys.FirstOrDefault(k => cat.Name.Contains(k, StringComparison.OrdinalIgnoreCase) || k.Contains(cat.Name, StringComparison.OrdinalIgnoreCase));
                            var icon = iconKey != null ? categoryIcons[iconKey] : "fa-utensils";
                        }
                        <i class="fa-solid @icon"></i>
                    </div>
                    <span>@cat.Name</span>
                </a>
            }
        </div>
    </div>
</section>

@if (combos.Any() && selectedCategory == null)
{
    <section id="combos-section" class="polyfood-combos-section">
        <div class="container">
            <div class="polyfood-section-header">
                <div class="polyfood-section-icon">
                    <i class="fa-solid fa-tags"></i>
                </div>
                <h3 class="polyfood-section-title">Gói Combo Tiết Kiệm</h3>
                <span class="polyfood-badge-warning">Combo đặc biệt</span>
            </div>
            @{
                var comboList = combos.ToList();
            }
            <div class="combo-grid-3">
                @for (int i = 0; i < Math.Min(comboList.Count, 3); i++)
                {
                    var combo = comboList[i];
                    var cImg = i < comboUnsplash.Count ? comboUnsplash[i] : combo.ImageUrl;
                    var discount = combo.OriginalPrice > 0 ? (int)Math.Round((1 - combo.Price / combo.OriginalPrice) * 100) : 20;

                    <div class="col reveal">
                        <div class="combo-card-vertical">
                            <div class="combo-card-img-wrap">
                                <img src="@cImg" alt="@combo.Name" loading="lazy">
                                <span class="combo-discount-tag">TIẾT KIỆM @discount%</span>
                            </div>
                            <div class="combo-card-body">
                                <h4 class="combo-card-title">@combo.Name</h4>
                                <p class="combo-card-desc">@combo.Description</p>
                                <div class="combo-card-footer">
                                    <div class="combo-pricing">
                                        @if (combo.OriginalPrice > 0)
                                        {
                                            <span class="combo-original-price">@combo.OriginalPrice.ToString("N0") ₫</span>
                                        }
                                        <span class="combo-current-price text-xl font-bold text-red-600">@combo.Price.ToString("N0") ₫</span>
                                    </div>
                                    <button onclick="addToCart(@combo.Id, true, 1, this)" class="combo-btn-order">Đặt Combo</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<section id="foods-section" class="container">
    <div class="polyfood-section-header">
        <div class="polyfood-section-icon">
            <i class="fa-solid fa-fire"></i>
        </div>
        <h3 class="polyfood-section-title">Thực đơn Món Lẻ Nổi Bật</h3>
    </div>

    <div id="food-list-container">
    <div class="food-grid-4">
        @{
            var foodsList = Model?.Take(8).ToList() ?? new List<Source.Models.FastFood>();
        }
        @if (!foodsList.Any())
        {
            <div class="empty-state col-12">
                <div class="empty-state-icon"><i class="fa-solid fa-face-frown"></i></div>
                <h5 class="empty-state-title">Chưa có món ăn nào</h5>
                <p class="empty-state-text">Vui lòng quay lại sau.</p>
            </div>
        }
        else
        {
            @foreach (var item in foodsList)
            {
                <div class="reveal">
                    <div class="food-card">
                        <div class="food-img-wrap">
                            <img src="@item.ImageUrl" alt="@item.Name" loading="lazy">
                            <span class="food-category-badge">@item.Category?.Name</span>
                        </div>
                        <div class="food-body">
                            <h5 class="food-name">@item.Name</h5>
                            <p class="food-desc">@item.Description</p>
                            <div class="food-footer">
                                <span class="food-price">@item.Price.ToString("N0") ₫</span>
                                <button onclick="addToCart(@item.Id, false, 1, this)" class="btn-add-cart" title="Thêm vào giỏ hàng">
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { searchName = searchName, categoryId = selectedCategory, sortOrder = sortOrder, page = pageNumber - 1 })">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == pageNumber ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { searchName = searchName, categoryId = selectedCategory, sortOrder = sortOrder, page = i })">@i</a>
                    </li>
                }
                <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { searchName = searchName, categoryId = selectedCategory, sortOrder = sortOrder, page = pageNumber + 1 })">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
    </div>

    <div class="text-center mt-4">
        <a asp-controller="Home" asp-action="Menu" class="btn btn-primary-custom btn-custom">Xem toàn bộ thực đơn</a>
    </div>
</section>

<section class="container">
    <div class="promo-banner-gradient">
        <div class="promo-banner-gradient-content">
            <div>
                <h3>Giảm ngay 20% cho đơn hàng đầu tiên!</h3>
                <p>Nhập mã khuyến mãi để nhận ưu đãi đặc biệt từ PolyFood. Áp dụng cho tất cả các món ăn.</p>
                <div class="promo-code-box-white">WELCOME20</div>
            </div>
            <a href="#foods-section" class="promo-btn-white">Nhận ưu đãi</a>
        </div>
    </div>
</section>

<section class="container">
    <div class="features-bar">
        <div class="feature-item">
            <div class="feature-icon"><i class="fa-solid fa-truck-fast"></i></div>
            <h6>Giao hàng siêu tốc</h6>
            <p>Trong vòng 30 phút</p>
        </div>
        <div class="feature-item">
            <div class="feature-icon"><i class="fa-solid fa-leaf"></i></div>
            <h6>Nguyên liệu sạch</h6>
            <p>An toàn vệ sinh</p>
        </div>
        <div class="feature-item">
            <div class="feature-icon"><i class="fa-solid fa-headset"></i></div>
            <h6>Hỗ trợ 24/7</h6>
            <p>Tư vấn tận tình</p>
        </div>
        <div class="feature-item">
            <div class="feature-icon"><i class="fa-solid fa-wallet"></i></div>
            <h6>Thanh toán linh hoạt</h6>
            <p>Tiền mặt & chuyển khoản</p>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            initHomepageSlider();
        });

        function initHomepageSlider() {
            const slider = document.getElementById('homepageSlider');
            const slides = slider.querySelectorAll('.slider-item');
            const prevBtn = slider.querySelector('.prev');
            const nextBtn = slider.querySelector('.next');
            const dots = slider.querySelectorAll('.slider-dot');
            let currentSlide = 0;
            let totalSlides = slides.length;
            let slideInterval;
            
            // Show current slide
            function showSlide(index) {
                // Hide all slides
                slides.forEach(slide => slide.classList.remove('active'));
                dots.forEach(dot => dot.classList.remove('active'));
                
                // Wrap around
                if (index >= totalSlides) index = 0;
                if (index < 0) index = totalSlides - 1;
                
                // Show current
                slides[index].classList.add('active');
                dots[index].classList.add('active');
                currentSlide = index;
            }
            
            // Auto-slide function
            function autoSlide() {
                currentSlide++;
                showSlide(currentSlide);
            }
            
            // Event listeners
            prevBtn.addEventListener('click', () => {
                currentSlide--;
                showSlide(currentSlide);
                resetInterval();
            });
            
            nextBtn.addEventListener('click', () => {
                currentSlide++;
                showSlide(currentSlide);
                resetInterval();
            });
            
            // Dot click
            dots.forEach((dot, index) => {
                dot.addEventListener('click', () => {
                    showSlide(index);
                    resetInterval();
                });
            });
            
            // Pause on hover, resume when mouse leaves
            slider.addEventListener('mouseenter', () => {
                clearInterval(slideInterval);
            });
            slider.addEventListener('mouseleave', startAutoSlide);
            
            // Start auto-slide
            function startAutoSlide() {
                slideInterval = setInterval(autoSlide, 5000); // 5 seconds
            }
            startAutoSlide();
        }
    </script>
}
