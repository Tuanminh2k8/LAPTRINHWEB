                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2"><i class="fa-solid fa-tag me-1"></i>@Model.Theme</span>
                        }
                    </div>
                    
                    <h1 class="fw-bold text-dark mb-3" style="font-size:1.8rem;">@Model.Name</h1>
                    <h2 class="text-danger fw-800 mb-4">@Model.Price.ToString("N0") ₫</h2>
                    
                    <hr class="my-4">
                    
