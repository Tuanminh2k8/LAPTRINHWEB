@{
    var relatedFoods = ViewBag.RelatedFoods as IEnumerable<Source.Models.FastFood> ?? new List<Source.Models.FastFood>();
}

@if (relatedFoods.Any())
{
    <div class="container my-5">
        <h4 class="fw-bold mb-4"><i class="fa-solid fa-star text-warning me-2"></i>Có thể bạn cũng thích</h4>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var item in relatedFoods)
            {
                <div class="col">
                    <div class="card-food">
                        <div class="card-img-container">
                            <img src="@item.ImageUrl" alt="@item.Name" loading="lazy">
                            <span class="food-badge">@item.Category?.Name</span>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-description">@item.Description</p>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <span class="price-tag">@item.Price.ToString("N0") ₫</span>
                                <a asp-action="FoodDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Xem</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

