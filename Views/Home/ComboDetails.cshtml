@model Source.Models.Combo
@{
    ViewData["Title"] = "Chi Tiết Combo - " + Model.Name;
}

<div class="container my-5">
    <div class="row g-5">
        <!-- Combo Image -->
        <div class="col-lg-6">
            <div class="detail-image-card">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid w-100">
            </div>
        </div>

        <!-- Combo Info -->
        <div class="col-lg-6">
            <div class="glass-panel h-100 d-flex flex-column justify-content-between">
                <div>
                    <span class="badge bg-danger rounded-pill px-3 py-2 mb-3">Gói Combo Tiết Kiệm</span>
                    
                    <h1 class="fw-bold text-dark mb-3">@Model.Name</h1>
                    <h2 class="text-danger fw-800 mb-4">@Model.Price.ToString("N0") ₫</h2>
                    
                    <hr>
                    
                    <h5 class="fw-bold text-muted mb-2">Mô tả Combo:</h5>
                    <p class="fs-6 text-secondary mb-4">@Model.Description</p>

                    <h5 class="fw-bold text-muted mb-3"><i class="fa-solid fa-utensils text-danger me-2"></i>Thực đơn trong Combo gồm:</h5>
                    <div class="list-group mb-4">
                        @foreach (var detail in Model.ComboDetails)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center border-0 bg-light rounded-3 mb-2 p-3">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@detail.FastFood?.ImageUrl" alt="@detail.FastFood?.Name" class="rounded-3" style="width: 45px; height: 45px; object-fit: cover;">
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0">@detail.FastFood?.Name</h6>
                                        <span class="small text-muted">@detail.FastFood?.Category?.Name</span>
                                    </div>
                                </div>
                                <span class="badge bg-danger rounded-pill px-3 py-2">x @detail.Quantity</span>
                            </div>
                        }
                    </div>
                </div>

                <div>
                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                        <input type="hidden" name="id" value="@Model.Id">
                        <input type="hidden" name="isCombo" value="true">
                        
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <span class="fw-bold text-dark">Số lượng Combo:</span>
                            <div class="quantity-control">
                                <button type="button" onclick="changeQty(-1, 20)">-</button>
                                <input type="number" id="quantityInput" name="quantity" value="1" min="1" max="20">
                                <button type="button" onclick="changeQty(1, 20)">+</button>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-action="Index" class="btn btn-secondary-custom btn-custom flex-grow-1 text-center">Quay lại Menu</a>
                            <button type="submit" class="btn btn-primary-custom btn-custom flex-grow-1 py-3">
                                <i class="fa-solid fa-cart-plus me-2"></i> Đặt Combo Ngay
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    var relatedCombos = ViewBag.RelatedCombos as IEnumerable<Source.Models.Combo> ?? new List<Source.Models.Combo>();
}

@if (relatedCombos.Any())
{
    <div class="container my-5">
        <h4 class="fw-bold mb-4"><i class="fa-solid fa-box-open text-danger me-2"></i>Combo khác bạn có thể thích</h4>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var combo in relatedCombos)
            {
                <div class="col">
                    <div class="card border-0 shadow-sm rounded-3 overflow-hidden h-100" style="background: linear-gradient(135deg, #fff 60%, #fffbf0 100%);">
                        <div class="row g-0 h-100">
                            <div class="col-sm-5 position-relative bg-light" style="min-height: 160px;">
                                <img src="@combo.ImageUrl" alt="@combo.Name" class="w-100 h-100 position-absolute start-0 top-0" style="object-fit: cover;">
                            </div>
                            <div class="col-sm-7">
                                <div class="card-body p-3 d-flex flex-column h-100">
                                    <h5 class="fw-bold text-dark">@combo.Name</h5>
                                    <p class="text-muted small flex-grow-1">@combo.Description</p>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                        <span class="fs-5 fw-800 text-danger">@combo.Price.ToString("N0") ₫</span>
                                        <a asp-action="ComboDetails" asp-route-id="@combo.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Chi tiết</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
