@{
    ViewData["Title"] = "Không phải tài xế";
    Layout = "_DriverLayout";
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body text-center py-5">
        <i class="fa-solid fa-motorcycle fa-3x text-secondary mb-3"></i>
        <h5 class="fw-bold">Tài khoản của bạn không phải tài xế</h5>
        <p class="text-muted">Bạn cần được cấp quyền tài xế bởi quản trị viên để truy cập kênh tài xế.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
            <i class="fa-solid fa-house me-1"></i>Về trang chủ
        </a>
    </div>
</div>