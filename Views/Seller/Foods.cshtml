@model IEnumerable<Source.Models.FastFood>
@{
    Layout = "_SellerLayout";
    ViewData["Title"] = "Quản lý Món ăn";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h4 class="fw-bold text-dark mb-1">Danh Sách Món Ăn</h4>
        <p class="text-muted small mb-0">Quản lý thực đơn và tình trạng còn hàng của các món ăn</p>
    </div>
    <a asp-action="FoodCreate" class="btn btn-seller-primary rounded-pill px-4">
        <i class="fa-solid fa-plus me-1"></i> Thêm Món Mới
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr class="small text-muted text-uppercase">
                    <th class="ps-4" style="width: 100px;">Hình ảnh</th>
                    <th>Tên món ăn</th>
                    <th>Danh mục</th>
                    <th>Đơn giá</th>
                    <th>Chủ đề</th>
                    <th>Tình trạng</th>
                    <th>Đã bán</th>
                    <th class="pe-4 text-end" style="width: 260px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-burger fa-3x mb-3 text-muted"></i>
                            <p class="small mb-0">Bạn chưa đăng bán món ăn nào.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <img src="@item.ImageUrl" alt="@item.Name" class="rounded-3 border" style="width: 54px; height: 54px; object-fit: cover;" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.Name</div>
                                <div class="text-muted text-truncate small" style="max-width: 250px;">@item.Description</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.Category?.Name</span>
                            </td>
                            <td class="fw-bold text-danger">@item.Price.ToString("N0") ₫</td>
                            <td class="small text-muted">@item.Theme</td>
                            <td>
                                @if (item.IsAvailable)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success border-opacity-10"><i class="fa-solid fa-circle-check me-1"></i>Còn hàng</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger border-opacity-10"><i class="fa-solid fa-circle-xmark me-1"></i>Hết hàng</span>
                                }
                            </td>
                            <td class="fw-bold">@item.SoldCount</td>
                            <td class="pe-4 text-end">
                                <div class="d-flex justify-content-end gap-1 flex-wrap">
                                    <a asp-action="Modifiers" asp-route-foodId="@item.Id" class="btn btn-sm btn-outline-warning rounded-pill px-2 py-1" title="Quản lý tùy chọn món">
                                        <i class="fa-solid fa-sliders"></i> Tùy chọn
                                    </a>
                                    <a asp-action="FoodEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1" title="Chỉnh sửa">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <form asp-action="FoodDelete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa món ăn này không?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1" title="Xóa">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white border-0 p-4">
            <nav aria-label="Phân trang món ăn">
                <ul class="pagination pagination-sm justify-content-center mb-0 gap-1">
                    @{
                        var prevDisabled = ViewBag.CurrentPage <= 1 ? "disabled" : "";
                        var nextDisabled = ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "";
                    }
                    <li class="page-item @prevDisabled">
                        <a class="page-link rounded-3 px-3" asp-action="Foods" asp-route-page="@(ViewBag.CurrentPage - 1)">
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        var active = i == ViewBag.CurrentPage ? "active" : "";
                        <li class="page-item @active">
                            <a class="page-link rounded-3 px-3 @active" asp-action="Foods" asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @nextDisabled">
                        <a class="page-link rounded-3 px-3" asp-action="Foods" asp-route-page="@(ViewBag.CurrentPage + 1)">
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
