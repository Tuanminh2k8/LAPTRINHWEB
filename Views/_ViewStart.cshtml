@using Source.Helpers
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var httpContext = HttpContextAccessor.HttpContext;
    var deviceType = httpContext != null ? DeviceDetectionHelper.DetectDeviceType(httpContext.Request) : DeviceDetectionHelper.Desktop;
    Layout = deviceType == DeviceDetectionHelper.Mobile ? "_Layout.mobile" : "_Layout";
}
